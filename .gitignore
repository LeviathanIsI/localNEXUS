# LocalNEXUS
#
# Application data lives outside this repository, in %LOCALAPPDATA%\LocalNEXUS\
# (models, graphs, logs, config.json). Nothing there is tracked by git, so there is
# no rule for it below. Only build output, editor state and fetched binaries are.

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
bin/
obj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]64/
build/
artifacts/
publish/
*.dll
*.exe
*.pdb
*.cache
*.binlog

# ---------------------------------------------------------------------------
# Visual Studio
# ---------------------------------------------------------------------------
.vs/
*.user
*.suo
*.userprefs
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb
*.psess
*.vsp
*.vspx

# ---------------------------------------------------------------------------
# Rider and other JetBrains IDEs
# ---------------------------------------------------------------------------
.idea/
*.sln.iml
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# ---------------------------------------------------------------------------
# Visual Studio Code
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json

# ---------------------------------------------------------------------------
# NuGet
# ---------------------------------------------------------------------------
*.nupkg
*.snupkg
packages/
!packages/build/
project.lock.json
project.assets.json

# ---------------------------------------------------------------------------
# Bundled llama.cpp binaries
#
# These are fetched per machine rather than committed: they are large, they are
# GPU build specific, and they carry their own license. See the README for how
# to place a build here. The folder itself is kept so the path always exists.
# ---------------------------------------------------------------------------
vendor/llama/*
!vendor/llama/README.md

# ---------------------------------------------------------------------------
# Model weights. Never commit these, anywhere, at any size.
# ---------------------------------------------------------------------------
*.gguf
*.ggml
*.safetensors
*.bin
models/

# ---------------------------------------------------------------------------
# Operating system noise
# ---------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
