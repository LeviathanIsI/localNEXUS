<Application x:Class="LocalNEXUS.Installer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Order matters and is the same order the application merges its own: colours,
                    then the brushes built from them, then the styles that use those brushes.
                -->
                <ResourceDictionary Source="Views/Theme/InstallerTheme.xaml" />
                <ResourceDictionary Source="Views/Theme/Brushes.xaml" />
                <ResourceDictionary Source="Views/Theme/Controls.xaml" />
                <ResourceDictionary Source="Views/StepTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
