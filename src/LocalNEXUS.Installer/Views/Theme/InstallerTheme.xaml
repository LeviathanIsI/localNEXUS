<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        A sixth theme, in the same shape as the application's five: about thirty named Colors and
        nothing else, so that every brush and every style downstream reads a key rather than a
        literal. This is the one place a colour appears in the installer.

        Why a new dictionary rather than one of the application's five. Two of them are close in
        spirit, NearBlack in particular, which already carries a purple accent at #7C5CFF. None
        of them can produce this design, because the design's defining element is a blue to
        purple gradient and a theme in this application is a flat list of Color values by
        construction. Picking NearBlack would have given a near black neutral grey where the
        mockup asks for a dark navy, and no gradient at all.

        So the mechanism is reused exactly, the key names are the application's key names, and
        the values are the ones the design calls for.
    -->

    <!-- Surfaces. Dark navy rather than the application's neutral greys. -->
    <Color x:Key="Surface.WindowColor">#FF14161F</Color>
    <Color x:Key="Surface.PanelColor">#FF101219</Color>
    <Color x:Key="Surface.CardColor">#FF181A24</Color>
    <Color x:Key="Surface.InputColor">#FF1C1F2B</Color>
    <Color x:Key="Surface.BorderColor">#24FFFFFF</Color>
    <Color x:Key="Surface.SubtleBorderColor">#14FFFFFF</Color>
    <Color x:Key="Surface.ChromeColor">#FF0F111A</Color>
    <Color x:Key="Surface.HoverColor">#12FFFFFF</Color>
    <Color x:Key="Surface.LogColor">#FF0C0D13</Color>
    <Color x:Key="Surface.ScrimColor">#B2000000</Color>

    <!-- Text. Faintly blue rather than neutral, which is what keeps it sitting on the navy. -->
    <Color x:Key="Text.PrimaryColor">#FFEEF0FB</Color>
    <Color x:Key="Text.SecondaryColor">#A6F1F2FB</Color>
    <Color x:Key="Text.MutedColor">#66F1F2FB</Color>
    <Color x:Key="Text.InverseColor">#FFFFFFFF</Color>
    <Color x:Key="Text.DisabledColor">#59F1F2FB</Color>

    <!--
        The accent is two colours because it is a gradient everywhere it appears: the logo mark,
        the primary button, the progress fill, the completed step circles and every selected
        state. A single accent colour cannot express that, which is the reason this dictionary
        exists at all.
    -->
    <Color x:Key="Accent.StartColor">#FF5CA4FF</Color>
    <Color x:Key="Accent.EndColor">#FFAE6BF3</Color>
    <Color x:Key="Accent.PrimaryColor">#FF8A87F7</Color>
    <Color x:Key="Accent.SoftColor">#2E7C8BFF</Color>
    <Color x:Key="Accent.GlowColor">#665CA4FF</Color>

    <!-- States, kept for the download log so a failure reads as one. -->
    <Color x:Key="Status.SuccessColor">#FF4ADE80</Color>
    <Color x:Key="Status.WarningColor">#FFFBBF24</Color>
    <Color x:Key="Status.ErrorColor">#FFF87171</Color>
    <Color x:Key="Status.InfoColor">#FF5CA4FF</Color>

    <!-- The window backdrop, which is a gradient rather than a flat fill. -->
    <Color x:Key="Backdrop.TopColor">#FF1A1D2E</Color>
    <Color x:Key="Backdrop.BottomColor">#FF0E1018</Color>
    <Color x:Key="Backdrop.GlowColor">#3357308C</Color>

</ResourceDictionary>
