<UserControl x:Class="LocalNEXUS.App.Views.PeersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LocalNEXUS.App.ViewModels"
             xmlns:distributed="clr-namespace:LocalNEXUS.App.Services.Distributed"
             d:DataContext="{d:DesignInstance Type=vm:PeersViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Border Background="{StaticResource Surface.Panel.Brush}"
            BorderBrush="{StaticResource Surface.Border.Brush}"
            BorderThickness="1,0,0,0">
        <DockPanel>

            <Border DockPanel.Dock="Top"
                    Background="{StaticResource Surface.Panel.Brush}"
                    BorderBrush="{StaticResource Surface.Border.Brush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource SmallButton}"
                            Content="Hide"
                            Command="{Binding TogglePanelCommand}" />
                    <TextBlock Text="Peers"
                               FontWeight="SemiBold"
                               FontSize="14"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12">
                <StackPanel>

                    <!-- Contribution: this install as a source for other orchestrators -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Contribution" />
                    <TextBlock Text="{Binding Worker.StatusText}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Text.Secondary.Brush}"
                               FontSize="{StaticResource Font.Size.Small}" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="rpc-server port" />
                            <TextBox Text="{Binding Worker.Port, UpdateSourceTrigger=LostFocus}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Worker.IsRunning}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Memory to offer (MiB)" />
                            <TextBox Text="{Binding Registry.ThisMachine.Capabilities.MemoryMb, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource HintText}"
                               Text="The offer is declared, not enforced: orchestrators honour it through their split proportions, because the bundled rpc-server has no cap flag." />

                    <Button Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding ToggleContributionCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="Start contributing" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Worker.IsRunning}" Value="True">
                                        <Setter Property="Content" Value="Stop contributing" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Known sources and their health -->
                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,22,0,6" Text="Sources" />

                    <ItemsControl ItemsSource="{Binding Registry.Sources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type distributed:InferenceSource}">
                                <Border Background="{StaticResource Surface.Card.Brush}"
                                        BorderBrush="{StaticResource Surface.Border.Brush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10,8"
                                        Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding State}"
                                                       VerticalAlignment="Center"
                                                       FontSize="{StaticResource Font.Size.Small}"
                                                       Foreground="{Binding State, Converter={StaticResource ResourceLookup}, ConverterParameter=SourceState}" />
                                            <Ellipse Width="9"
                                                     Height="9"
                                                     Margin="0,0,7,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding State, Converter={StaticResource ResourceLookup}, ConverterParameter=SourceState}" />
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding EndpointText}"
                                                       FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="{StaticResource Font.Size.Small}"
                                                       Foreground="{StaticResource Text.Secondary.Brush}" />
                                            <TextBlock Text="{Binding Locality}"
                                                       Margin="10,0,0,0"
                                                       FontSize="{StaticResource Font.Size.Small}"
                                                       Foreground="{StaticResource Text.Secondary.Brush}" />
                                        </StackPanel>

                                        <TextBlock FontSize="{StaticResource Font.Size.Small}"
                                                   Foreground="{StaticResource Text.Secondary.Brush}"
                                                   Margin="0,2,0,0">
                                            <Run Text="Last seen" /><Run Text=" " /><Run Text="{Binding LastSeenText, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding ReachabilitySummary, Mode=OneWay}" />
                                        </TextBlock>

                                        <TextBlock Text="{Binding Capabilities.Summary}"
                                                   FontSize="{StaticResource Font.Size.Small}"
                                                   Foreground="{StaticResource Text.Secondary.Brush}"
                                                   Margin="0,2,0,0" />

                                        <Expander Header="Edit"
                                                  Margin="0,6,0,0"
                                                  Foreground="{StaticResource Text.Secondary.Brush}"
                                                  FontSize="{StaticResource Font.Size.Small}">
                                            <StackPanel Margin="0,6,0,0">
                                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Display name" />
                                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=LostFocus}" />

                                                <Grid Margin="0,6,0,0">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsThisMachine}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Host" />
                                                        <TextBox Text="{Binding Host, UpdateSourceTrigger=LostFocus}"
                                                                 FontFamily="{StaticResource Font.Mono}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Port" />
                                                        <TextBox Text="{Binding Port, UpdateSourceTrigger=LostFocus}"
                                                                 FontFamily="{StaticResource Font.Mono}" />
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,6,0,4" Text="Declared memory (MiB)" />
                                                <TextBox Text="{Binding Capabilities.MemoryMb, UpdateSourceTrigger=LostFocus}" />

                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsThisMachine}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Button Style="{StaticResource SmallButton}"
                                                            Content="Probe now"
                                                            Margin="0,0,6,0"
                                                            CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.ProbeNowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    <Button Style="{StaticResource SmallButton}"
                                                            Content="Remove"
                                                            CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Registering another machine -->
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,4,0,4" Text="Add a source" />
                    <TextBox Text="{Binding NewSourceName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Display name" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding NewSourceHost, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource Font.Mono}"
                                 ToolTip="Host name or address" />
                        <TextBox Grid.Column="2"
                                 Text="{Binding NewSourcePort, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource Font.Mono}"
                                 ToolTip="Port" />
                    </Grid>
                    <TextBox Margin="0,6,0,0"
                             Text="{Binding NewSourceMemoryMb, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Declared memory in MiB, blank for unknown" />
                    <CheckBox Content="Reached over the internet"
                              Margin="0,8,0,0"
                              IsChecked="{Binding NewSourceIsInternet}" />
                    <Button Style="{StaticResource SmallButton}"
                            Content="Add source"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding AddSourceCommand}" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="The other machine runs LocalNEXUS with contribution turned on, or a bare rpc-server. The default port is 50052. Name, host and port are all it takes; memory improves the automatic split." />

                    <!-- Coverage chain for the selected model -->
                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,22,0,0" Text="Coverage" />
                    <TextBlock Text="{Binding CoverageStatus}"
                               Margin="0,6,0,8"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Text.Secondary.Brush}"
                               FontSize="{StaticResource Font.Size.Small}" />

                    <ItemsControl ItemsSource="{Binding CoveragePlan.Assignments}"
                                  Visibility="{Binding HasCoveragePlan, Converter={StaticResource BooleanToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type distributed:SourceAssignment}">
                                <Border Background="{StaticResource Surface.Card.Brush}"
                                        CornerRadius="3"
                                        Padding="9,7"
                                        Margin="0,0,0,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderThickness" Value="3,1,1,1" />
                                            <Setter Property="BorderBrush" Value="{Binding Source.State, Converter={StaticResource ResourceLookup}, ConverterParameter=SourceState}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCovered}" Value="False">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Wire.False.Brush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Section.Label}"
                                                   FontWeight="SemiBold"
                                                   FontSize="{StaticResource Font.Size.Small}" />
                                        <TextBlock Margin="0,2,0,0" FontSize="{StaticResource Font.Size.Small}">
                                            <Run Text="{Binding SourceText, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Proportion, Mode=OneWay, StringFormat=P0}"
                                                 Foreground="{StaticResource Text.Secondary.Brush}" />
                                        </TextBlock>
                                        <TextBlock FontSize="{StaticResource Font.Size.Small}"
                                                   Foreground="{StaticResource Text.Secondary.Brush}"
                                                   Margin="0,2,0,0">
                                            <Run Text="{Binding Redundancy, Mode=OneWay}" /><Run Text=" source(s) could cover this section" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
