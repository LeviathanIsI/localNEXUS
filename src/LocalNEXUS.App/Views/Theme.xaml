<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:converters="clr-namespace:LocalNEXUS.App.Infrastructure.Converters">

    <!--
        Palette. Converters resolve brushes by formatting a value into a key, for example
        "Pin.{0}.Brush" plus a PinType of Code resolves Pin.Code.Brush. Adding a pin type, node
        state or activity kind therefore means adding a brush here and nothing else.
    -->

    <Color x:Key="Surface.WindowColor">#FF101219</Color>
    <Color x:Key="Surface.PanelColor">#FF161A23</Color>
    <Color x:Key="Surface.CardColor">#FF1E2330</Color>
    <Color x:Key="Surface.InputColor">#FF11151E</Color>
    <Color x:Key="Surface.BorderColor">#FF2C3444</Color>
    <Color x:Key="Text.PrimaryColor">#FFE3E8F2</Color>
    <Color x:Key="Text.SecondaryColor">#FF919CB4</Color>
    <Color x:Key="Accent.PrimaryColor">#FF5B8DEF</Color>

    <SolidColorBrush x:Key="Surface.Window.Brush" Color="{StaticResource Surface.WindowColor}" />
    <SolidColorBrush x:Key="Surface.Panel.Brush" Color="{StaticResource Surface.PanelColor}" />
    <SolidColorBrush x:Key="Surface.Card.Brush" Color="{StaticResource Surface.CardColor}" />
    <SolidColorBrush x:Key="Surface.Input.Brush" Color="{StaticResource Surface.InputColor}" />
    <SolidColorBrush x:Key="Surface.Border.Brush" Color="{StaticResource Surface.BorderColor}" />
    <SolidColorBrush x:Key="Text.Primary.Brush" Color="{StaticResource Text.PrimaryColor}" />
    <SolidColorBrush x:Key="Text.Secondary.Brush" Color="{StaticResource Text.SecondaryColor}" />
    <SolidColorBrush x:Key="Accent.Primary.Brush" Color="{StaticResource Accent.PrimaryColor}" />
    <SolidColorBrush x:Key="Accent.Neutral.Brush" Color="#FF6B7686" />

    <!-- Pin types. Text is a soft blue, Code is amber. -->
    <SolidColorBrush x:Key="Pin.Text.Brush" Color="#FF6FB1FF" />
    <SolidColorBrush x:Key="Pin.Code.Brush" Color="#FFFFB454" />

    <!--
        Section coverage in the network tab's chain and model list. Starting is the same blue as
        a running node rather than a shade of red, because a section that has not finished
        loading has not failed at anything.
    -->
    <SolidColorBrush x:Key="SectionCoverage.Starting.Brush" Color="#FF4EA1FF" />
    <SolidColorBrush x:Key="SectionCoverage.Healthy.Brush" Color="#FF4ADE80" />
    <SolidColorBrush x:Key="SectionCoverage.Thin.Brush" Color="#FFFFB454" />
    <SolidColorBrush x:Key="SectionCoverage.Uncovered.Brush" Color="#FFF87171" />

    <!-- Source states in the peer panel. -->
    <SolidColorBrush x:Key="SourceState.Unknown.Brush" Color="#FF6B7686" />
    <SolidColorBrush x:Key="SourceState.Available.Brush" Color="#FF4ADE80" />
    <SolidColorBrush x:Key="SourceState.Serving.Brush" Color="#FF4ADE80" />
    <SolidColorBrush x:Key="SourceState.Unreachable.Brush" Color="#FFF87171" />

    <!-- This install's own mesh node, on the This machine card. -->
    <SolidColorBrush x:Key="MeshNodeState.Stopped.Brush" Color="#FF6B7686" />
    <SolidColorBrush x:Key="MeshNodeState.Starting.Brush" Color="#FF4EA1FF" />
    <SolidColorBrush x:Key="MeshNodeState.Client.Brush" Color="#FF4ADE80" />
    <SolidColorBrush x:Key="MeshNodeState.Serving.Brush" Color="#FF4ADE80" />
    <SolidColorBrush x:Key="MeshNodeState.Failed.Brush" Color="#FFF87171" />

    <!-- Node execution states. -->
    <SolidColorBrush x:Key="NodeState.Pending.Brush" Color="#FF6B7686" />
    <SolidColorBrush x:Key="NodeState.Running.Brush" Color="#FF4EA1FF" />
    <SolidColorBrush x:Key="NodeState.Completed.Brush" Color="#FF4ADE80" />
    <SolidColorBrush x:Key="NodeState.Faulted.Brush" Color="#FFF87171" />

    <!-- Node header accents by type. -->
    <SolidColorBrush x:Key="NodeType.Input.Brush" Color="#FF2E4F7A" />
    <SolidColorBrush x:Key="NodeType.Model.Brush" Color="#FF3C3566" />
    <SolidColorBrush x:Key="NodeType.Transform.Brush" Color="#FF2B5348" />
    <SolidColorBrush x:Key="NodeType.Output.Brush" Color="#FF6B4326" />

    <!-- Activity feed accents. -->
    <SolidColorBrush x:Key="Activity.Info.Brush" Color="#FF7F8CA3" />
    <SolidColorBrush x:Key="Activity.Request.Brush" Color="#FF9C8CFF" />
    <SolidColorBrush x:Key="Activity.RunStarted.Brush" Color="#FF5B8DEF" />
    <SolidColorBrush x:Key="Activity.RunCompleted.Brush" Color="#FF4ADE80" />
    <SolidColorBrush x:Key="Activity.RunFaulted.Brush" Color="#FFF87171" />
    <SolidColorBrush x:Key="Activity.NodeStarted.Brush" Color="#FF4EA1FF" />
    <SolidColorBrush x:Key="Activity.NodeCompleted.Brush" Color="#FF4ADE80" />
    <SolidColorBrush x:Key="Activity.NodeFaulted.Brush" Color="#FFF87171" />
    <SolidColorBrush x:Key="Activity.ModelStream.Brush" Color="#FFFFB454" />
    <SolidColorBrush x:Key="Activity.FileWritten.Brush" Color="#FF4ADE80" />
    <SolidColorBrush x:Key="Activity.Confirmation.Brush" Color="#FFFFD166" />
    <SolidColorBrush x:Key="Activity.Error.Brush" Color="#FFF87171" />

    <!-- A field level problem in a settings panel, for example a file that is no longer there. -->
    <SolidColorBrush x:Key="Field.Error.Brush" Color="#FFF87171" />

    <!-- Pending wire feedback: green while the drop would be accepted, red while it would not. -->
    <SolidColorBrush x:Key="Wire.True.Brush" Color="#FF7CE38B" />
    <SolidColorBrush x:Key="Wire.False.Brush" Color="#FFF87171" />

    <converters:ResourceLookupConverter x:Key="ResourceLookup" />
    <converters:EnumToBooleanConverter x:Key="EnumToBoolean" />
    <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

    <sys:Double x:Key="Font.Size.Small">11</sys:Double>
    <sys:Double x:Key="Font.Size.Normal">12.5</sys:Double>
    <sys:Double x:Key="Font.Size.Large">14</sys:Double>
    <sys:Double x:Key="Font.Size.Title">17</sys:Double>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- Base text -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text.Primary.Brush}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Normal}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary.Brush}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Small}" />
        <Setter Property="Margin" Value="0,10,0,4" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text.Primary.Brush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary.Brush}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Small}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- Text entry -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Surface.Input.Brush}" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary.Brush}" />
        <Setter Property="CaretBrush" Value="{StaticResource Text.Primary.Brush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent.Primary.Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Surface.Border.Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Normal}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                      Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent.Primary.Brush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MonoTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="SpellCheck.IsEnabled" Value="False" />
    </Style>

    <!-- Buttons -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Surface.Card.Brush}" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary.Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Surface.Border.Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Normal}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent.Primary.Brush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface.Input.Brush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Accent.Primary.Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent.Primary.Brush}" />
        <Setter Property="Foreground" Value="#FF0B1220" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Small}" />
    </Style>

    <!-- Check boxes and radio buttons -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text.Primary.Brush}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Normal}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box"
                                Width="15" Height="15"
                                CornerRadius="3"
                                VerticalAlignment="Center"
                                Background="{StaticResource Surface.Input.Brush}"
                                BorderBrush="{StaticResource Surface.Border.Brush}"
                                BorderThickness="1">
                            <Path x:Name="Tick"
                                  Data="M 2,6 L 5.5,10 L 12,2.5"
                                  Stroke="{StaticResource Accent.Primary.Brush}"
                                  StrokeThickness="2"
                                  Visibility="Collapsed"
                                  Stretch="None" />
                        </Border>
                        <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent.Primary.Brush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent.Primary.Brush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Text.Primary.Brush}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Normal}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Ring"
                                Width="15" Height="15"
                                CornerRadius="8"
                                VerticalAlignment="Center"
                                Background="{StaticResource Surface.Input.Brush}"
                                BorderBrush="{StaticResource Surface.Border.Brush}"
                                BorderThickness="1">
                            <Ellipse x:Name="Dot"
                                     Width="7" Height="7"
                                     Fill="{StaticResource Accent.Primary.Brush}"
                                     Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Accent.Primary.Brush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Accent.Primary.Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Combo box, retemplated so the popup matches the rest of the window -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root"
                            Background="{StaticResource Surface.Input.Brush}"
                            BorderBrush="{StaticResource Surface.Border.Brush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Path x:Name="Arrow"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,9,0"
                              Data="M 0,0 L 8,0 L 4,5 Z"
                              Fill="{StaticResource Text.Secondary.Brush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent.Primary.Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text.Primary.Brush}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Normal}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface.Card.Brush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Accent.Primary.Brush}" />
                            <Setter Property="Foreground" Value="#FF0B1220" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Text.Primary.Brush}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Normal}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboToggle}"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <TextBlock x:Name="Placeholder"
                                   Margin="{TemplateBinding Padding}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Text.Secondary.Brush}"
                                   Text="nothing to choose"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="{StaticResource Surface.Panel.Brush}"
                                    BorderBrush="{StaticResource Surface.Border.Brush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menus. The system template paints a white popup with system colours, so every role
         gets a dark template of its own. -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="{StaticResource Surface.Panel.Brush}" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary.Brush}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Normal}" />
        <Setter Property="Padding" Value="4,2" />
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource Surface.Border.Brush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,3" />
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource Surface.Border.Brush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Fill="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="MenuItem.TopLevelHeaderTemplate" TargetType="MenuItem">
        <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="10,5">
            <Grid>
                <ContentPresenter ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  VerticalAlignment="Center" />
                <Popup x:Name="PART_Popup"
                       Placement="Bottom"
                       VerticalOffset="4"
                       IsOpen="{TemplateBinding IsSubmenuOpen}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Fade">
                    <Border Background="{StaticResource Surface.Card.Brush}"
                            BorderBrush="{StaticResource Surface.Border.Brush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="4"
                            MinWidth="240">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface.Card.Brush}" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface.Card.Brush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MenuItem.TopLevelItemTemplate" TargetType="MenuItem">
        <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="10,5">
            <ContentPresenter ContentSource="Header"
                              RecognizesAccessKey="True"
                              VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface.Card.Brush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MenuItem.SubmenuItemTemplate" TargetType="MenuItem">
        <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="10,6" Margin="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0"
                                  ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{TemplateBinding InputGestureText}"
                           Margin="28,0,4,0"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource Font.Size.Small}"
                           Foreground="{StaticResource Text.Secondary.Brush}" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface.Input.Brush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MenuItem.SubmenuHeaderTemplate" TargetType="MenuItem">
        <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="10,6" Margin="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0"
                                  ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  VerticalAlignment="Center" />
                <Path Grid.Column="1"
                      Data="M 0 0 L 4 4 L 0 8 Z"
                      Fill="{StaticResource Text.Secondary.Brush}"
                      Margin="28,0,4,0"
                      VerticalAlignment="Center" />
                <Popup x:Name="PART_Popup"
                       Placement="Right"
                       HorizontalOffset="6"
                       IsOpen="{TemplateBinding IsSubmenuOpen}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Fade">
                    <Border Background="{StaticResource Surface.Card.Brush}"
                            BorderBrush="{StaticResource Surface.Border.Brush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="4"
                            MinWidth="200">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface.Input.Brush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Text.Primary.Brush}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Normal}" />
        <Setter Property="Template" Value="{StaticResource MenuItem.SubmenuItemTemplate}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource MenuItem.TopLevelHeaderTemplate}" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource MenuItem.TopLevelItemTemplate}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource MenuItem.SubmenuHeaderTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Top level tabs. A flat strip with an accent underline on the active tab. -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource Surface.Window.Brush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Background="{StaticResource Surface.Panel.Brush}"
                                BorderBrush="{StaticResource Surface.Border.Brush}"
                                BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" Margin="8,0,8,0" />
                        </Border>
                        <ContentPresenter ContentSource="SelectedContent" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary.Brush}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Large}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border Background="Transparent" Padding="16,9,16,7">
                        <StackPanel>
                            <ContentPresenter ContentSource="Header" />
                            <Rectangle x:Name="Underline"
                                       Height="2"
                                       Margin="0,6,0,0"
                                       RadiusX="1"
                                       RadiusY="1"
                                       Fill="Transparent" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary.Brush}" />
                            <Setter TargetName="Underline" Property="Fill" Value="{StaticResource Accent.Primary.Brush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary.Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Selection lists. The system template is a white box; the network tab's model list
         wants rounded cards with an accent border on the selected row. -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="{StaticResource Surface.Card.Brush}"
                            BorderBrush="{StaticResource Surface.Border.Brush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,10"
                            Padding="16,12">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent.Neutral.Brush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent.Primary.Brush}" />
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface.Input.Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Panels -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface.Card.Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Surface.Border.Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{StaticResource Surface.Border.Brush}" />
    </Style>

</ResourceDictionary>
