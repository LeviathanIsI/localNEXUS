<UserControl x:Class="LocalNEXUS.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LocalNEXUS.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:AppSettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource Surface.Window.Brush}">

    <!--
        Settings holds what is global; the tabs keep what is contextual. A watched folder, a theme
        and a cloud key belong to this install. Which model a node uses and which file it writes
        belong to the graph, so they stay on the node and get saved with it.

        Nothing here has an apply button. A settings panel with one can be left in a state where
        what is on screen and what is in force disagree, which is a bug the person has to notice.
    -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sections -->
        <Border Grid.Column="0"
                Background="{StaticResource Surface.Panel.Brush}"
                BorderBrush="{StaticResource Surface.Border.Brush}"
                BorderThickness="0,0,1,0">
            <StackPanel>
                <TextBlock Style="{StaticResource SideBarHeader}" Text="SETTINGS" />

                <ItemsControl>
                    <ItemsControl.Resources>
                        <Style TargetType="RadioButton">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary.Brush}" />
                            <Setter Property="FontSize" Value="{StaticResource Font.Size.Normal}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Root" Background="Transparent" Padding="14,7">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface.Hover.Brush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface.Selected.Brush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ItemsControl.Resources>

                    <RadioButton GroupName="SettingsSection" Content="Appearance"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBoolean}, ConverterParameter=Appearance, Mode=OneWay}"
                                 Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static vm:SettingsSection.Appearance}" />
                    <RadioButton GroupName="SettingsSection" Content="Models"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBoolean}, ConverterParameter=Models, Mode=OneWay}"
                                 Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static vm:SettingsSection.Models}" />
                    <RadioButton GroupName="SettingsSection" Content="Unity"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBoolean}, ConverterParameter=Unity, Mode=OneWay}"
                                 Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static vm:SettingsSection.Unity}" />
                    <RadioButton GroupName="SettingsSection" Content="Runtime"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBoolean}, ConverterParameter=Runtime, Mode=OneWay}"
                                 Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static vm:SettingsSection.Runtime}" />
                    <RadioButton GroupName="SettingsSection" Content="Behaviour"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBoolean}, ConverterParameter=Behaviour, Mode=OneWay}"
                                 Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static vm:SettingsSection.Behaviour}" />
                </ItemsControl>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <Grid MaxWidth="640" HorizontalAlignment="Left">

                <!-- Appearance -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVisibility}, ConverterParameter=Appearance}">
                    <TextBlock Style="{StaticResource SectionHeader}" FontSize="{StaticResource Font.Size.Title}" Text="Appearance" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Themes apply as they are picked. Nothing restarts, and the choice is remembered for the next session." />

                    <ItemsControl ItemsSource="{Binding ThemeChoices}" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="Theme"
                                             Margin="0,0,0,10"
                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                             Command="{Binding Pick}"
                                             CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0" Text="{Binding Description}" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                        A live sample rather than a swatch. Every one of these is a real state brush,
                        so the preview is the same colours the interface uses and cannot drift from
                        them.
                    -->
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="How states read in this theme" />

                            <ItemsControl Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                                    <Ellipse Style="{StaticResource StateDot}" Margin="0,0,7,0" Fill="{StaticResource Accent.Neutral.Brush}" />
                                    <TextBlock Text="pending" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                                    <Ellipse Style="{StaticResource StateDot}" Margin="0,0,7,0" Fill="{StaticResource Status.Info.Brush}" />
                                    <TextBlock Text="working" Foreground="{StaticResource Status.Info.Brush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                                    <Ellipse Style="{StaticResource StateDot}" Margin="0,0,7,0" Fill="{StaticResource Status.Success.Brush}" />
                                    <TextBlock Text="healthy" Foreground="{StaticResource Status.Success.Brush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                                    <Ellipse Style="{StaticResource StateDot}" Margin="0,0,7,0" Fill="{StaticResource Status.Warning.Brush}" />
                                    <TextBlock Text="thin" Foreground="{StaticResource Status.Warning.Brush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                                    <Ellipse Style="{StaticResource StateDot}" Margin="0,0,7,0" Fill="{StaticResource Status.Danger.Brush}" />
                                    <TextBlock Text="failed" Foreground="{StaticResource Status.Danger.Brush}" />
                                </StackPanel>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource MonoText}" Foreground="{StaticResource Diff.Added.Brush}" Text="+34" />
                                <TextBlock Style="{StaticResource MonoText}" Margin="8,0,20,0" Foreground="{StaticResource Diff.Removed.Brush}" Text="-6" />
                                <TextBlock Style="{StaticResource MonoText}" Text="Assets/Scripts/PlayerMovement.cs" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Rectangle Width="3" Height="18" Margin="0,0,7,0" Fill="{StaticResource NodeType.Input.Brush}" />
                                <Rectangle Width="3" Height="18" Margin="0,0,7,0" Fill="{StaticResource NodeType.Plan.Brush}" />
                                <Rectangle Width="3" Height="18" Margin="0,0,7,0" Fill="{StaticResource NodeType.Model.Brush}" />
                                <Rectangle Width="3" Height="18" Margin="0,0,7,0" Fill="{StaticResource NodeType.Transform.Brush}" />
                                <Rectangle Width="3" Height="18" Margin="0,0,7,0" Fill="{StaticResource NodeType.CompileCheck.Brush}" />
                                <Rectangle Width="3" Height="18" Margin="0,0,14,0" Fill="{StaticResource NodeType.Output.Brush}" />
                                <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Text="the six node accents" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Models -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVisibility}, ConverterParameter=Models}">
                    <TextBlock Style="{StaticResource SectionHeader}" FontSize="{StaticResource Font.Size.Title}" Text="Models" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Every folder here is scanned for both formats. Format is a label rather than a choice, and nothing asks which engine to use." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Folders being scanned" />

                    <ItemsControl ItemsSource="{Binding Folders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="10,7" Margin="0,0,0,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource LinkButton}"
                                                Margin="10,0,0,0"
                                                Content="Remove"
                                                Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding CanRemove, Converter={StaticResource BooleanToVisibility}}" />

                                        <TextBlock DockPanel.Dock="Right"
                                                   Style="{StaticResource MutedText}"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Origin}"
                                                   Visibility="{Binding CanRemove, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}" />

                                        <TextBlock Style="{StaticResource MonoText}"
                                                   Text="{Binding Path}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Path}" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource SmallButton}" Margin="0,0,8,0" Content="Add a folder" Command="{Binding AddFolderCommand}" />
                        <Button Style="{StaticResource SmallButton}" Margin="0,0,8,0" Content="Rescan" Command="{Binding RescanCommand}" />
                        <Button Style="{StaticResource SmallButton}" Content="Edit model-paths.txt" Command="{Binding EditModelPathsCommand}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource HintText}" Text="{Binding Catalog.SearchSummary}" />

                    <Rectangle Height="1" Margin="0,20,0,0" Fill="{StaticResource Surface.Border.Brush}" />

                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,16,0,0" Text="Cloud provider" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="What a newly added model node starts from, so a key is typed once rather than once per node. Existing nodes keep whatever they were saved with." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Base URL" />
                    <TextBox Text="{Binding CloudBaseUrl, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Style="{StaticResource HintText}" Text="Blank uses the default for whichever provider the node is set to." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="API key" />
                    <TextBox Text="{Binding CloudApiKey, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Font.Mono}" />
                    <TextBlock Style="{StaticResource HintText}"
                               Foreground="{StaticResource Status.Warning.Brush}"
                               Text="Stored in clear text in config.json, which is the same posture a graph file already has. Worth knowing before pasting a key into a file that gets shared." />
                </StackPanel>

                <!-- Unity -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVisibility}, ConverterParameter=Unity}">
                    <TextBlock Style="{StaticResource SectionHeader}" FontSize="{StaticResource Font.Size.Title}" Text="Unity" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Open project" />
                    <TextBlock Text="{Binding Index.IndexedProject, TargetNullValue=No project is open.}" />
                    <TextBlock Style="{StaticResource HintText}" Text="Open a different one from File, Open Unity project." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="What is known about it" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource StateDot}"
                                 Margin="0,0,8,0"
                                 Fill="{Binding Index.State, Converter={StaticResource ResourceLookup}, ConverterParameter=ProjectIndexState}" />
                        <TextBlock Text="{Binding Index.StatusText}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource MonoText}"
                               Margin="0,6,0,0"
                               Foreground="{StaticResource Text.Muted.Brush}"
                               Text="{Binding Index.Stage}" />

                    <Button Style="{StaticResource SmallButton}"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Content="Read the project again"
                            Command="{Binding ReindexCommand}" />

                    <TextBlock Style="{StaticResource HintText}"
                               Text="The index is cached per file by write time and length, so editing one script re-reads one script. Reading it again from scratch is only needed if something outside the editor changed a lot of files at once." />
                </StackPanel>

                <!-- Runtime -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVisibility}, ConverterParameter=Runtime}">
                    <TextBlock Style="{StaticResource SectionHeader}" FontSize="{StaticResource Font.Size.Title}" Text="Runtime" />

                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,14,0,0" Text="Python environment" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Ellipse Style="{StaticResource StateDot}"
                                 Margin="0,0,8,0"
                                 Fill="{Binding Python.Environment.State, Converter={StaticResource ResourceLookup}, ConverterParameter=PythonEnvironmentState}" />
                        <TextBlock Text="{Binding Python.Environment.StatusText}" />
                    </StackPanel>

                    <ProgressBar Margin="0,10,0,0"
                                 IsIndeterminate="True"
                                 Visibility="{Binding Python.Environment.IsBusy, Converter={StaticResource BooleanToVisibility}}" />

                    <TextBlock Style="{StaticResource MonoText}"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource Text.Muted.Brush}"
                               TextWrapping="Wrap"
                               Text="{Binding Python.Environment.Stage}" />

                    <TextBlock Style="{StaticResource MonoText}"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource Text.Muted.Brush}"
                               TextWrapping="Wrap"
                               Text="{Binding Python.Environment.Detail}" />

                    <TextBlock Style="{StaticResource HintText}"
                               Foreground="{StaticResource Field.Error.Brush}"
                               Text="{Binding Python.Environment.LastError}"
                               Visibility="{Binding Python.Environment.LastError, Converter={StaticResource StringToVisibility}}" />

                    <TextBlock Style="{StaticResource HintText}" Text="{Binding Python.Environment.AcceleratorSummary}" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource SmallButton}" Margin="0,0,8,0" Content="Repair" Command="{Binding Python.RepairCommand}" />
                        <Button Style="{StaticResource SmallButton}" Margin="0,0,8,0" Content="Set up again" Command="{Binding Python.ResetCommand}" />
                        <Button Style="{StaticResource SmallButton}" Content="Open its folder" Command="{Binding Python.OpenFolderCommand}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource HintText}"
                               Text="Built by the bundled uv into this install's own folder, never into a Python already on the machine. GGUF models work throughout, so this only matters for safetensors." />

                    <Rectangle Height="1" Margin="0,20,0,0" Fill="{StaticResource Surface.Border.Brush}" />

                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,16,0,0" Text="Mesh node" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Ellipse Style="{StaticResource StateDot}"
                                 Margin="0,0,8,0"
                                 Fill="{Binding Network.Mesh.State, Converter={StaticResource ResourceLookup}, ConverterParameter=MeshNodeState}" />
                        <TextBlock Text="{Binding Network.Mesh.StatusText}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Mesh name" />
                    <TextBox Text="{Binding Network.MeshName, UpdateSourceTrigger=LostFocus}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Invite token to join, if joining someone else" />
                    <TextBox Text="{Binding Network.JoinToken, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Font.Mono}" />

                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              Margin="0,14,0,0"
                              Content="Publish this mesh publicly"
                              IsChecked="{Binding Network.Publish}" />

                    <TextBlock Style="{StaticResource HintText}"
                               Foreground="{StaticResource Status.Warning.Brush}"
                               Text="Off by default. This is the only setting that causes any contact beyond the local network." />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource SmallButton}" Margin="0,0,8,0" Content="Apply and restart the node" Command="{Binding Network.ApplySettingsCommand}" />
                        <Button Style="{StaticResource SmallButton}" Margin="0,0,8,0" Content="Start or stop the node" Command="{Binding Network.ToggleMeshCommand}" />
                        <Button Style="{StaticResource SmallButton}" Content="Leave the mesh" Command="{Binding Network.LeaveMeshCommand}" />
                    </StackPanel>
                </StackPanel>

                <!-- Behaviour -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVisibility}, ConverterParameter=Behaviour}">
                    <TextBlock Style="{StaticResource SectionHeader}" FontSize="{StaticResource Font.Size.Title}" Text="Behaviour" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="What a newly added node starts from. These are starting points, never overrides: a node saves its own values into the graph, so changing a default here cannot reach back into a graph that already exists." />

                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,16,0,0" Text="Compile check" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Repair attempts after the first failure" />
                    <TextBox Text="{Binding DefaultRetryLimit, UpdateSourceTrigger=LostFocus}" MaxWidth="120" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource HintText}" Text="Each attempt is handed the compiler errors from the one before it. Zero means one compile and no repair." />

                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Plan context budget" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Project map" />
                            <TextBox Text="{Binding DefaultMapCharacters, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Candidate detail" />
                            <TextBox Text="{Binding DefaultCandidateCharacters, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Signatures this run" />
                            <TextBox Text="{Binding DefaultEmittedCharacters, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Candidate files offered before any is read" />
                    <TextBox Text="{Binding DefaultCandidateLimit, UpdateSourceTrigger=LostFocus}" MaxWidth="120" HorizontalAlignment="Left" />

                    <TextBlock Style="{StaticResource HintText}" Text="{Binding DefaultBudgetSummary}" />

                    <Rectangle Height="1" Margin="0,20,0,0" Fill="{StaticResource Surface.Border.Brush}" />

                    <Button Style="{StaticResource SmallButton}"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Left"
                            Content="Open this install's data folder"
                            Command="{Binding OpenDataFolderCommand}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
