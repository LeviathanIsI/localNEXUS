<UserControl x:Class="LocalNEXUS.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LocalNEXUS.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:AppSettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Surface.Window.Brush}">

    <!--
        Settings holds what is global; the tabs keep what is contextual. A watched folder, a theme
        and a cloud key belong to this install. Which model a node uses and which file it writes
        belong to the graph, so they stay on the node and get saved with it.

        Nothing here has an apply button. A settings panel with one can be left in a state where
        what is on screen and what is in force disagree, which is a bug the person has to notice.
    -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sections -->
        <Border Grid.Column="0"
                Background="{DynamicResource Surface.Panel.Brush}"
                BorderBrush="{DynamicResource Surface.Border.Brush}"
                BorderThickness="0,0,1,0">
            <StackPanel>
                <TextBlock Style="{StaticResource SideBarHeader}" Text="SETTINGS" />

                <!--
                    A list rather than five radio buttons, so choosing a section is the list's own
                    notion of selection and the keyboard works in it without being asked to.
                -->
                <ListBox ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding Section}"
                         ItemContainerStyle="{StaticResource ListRow}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="0,3" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <Grid MaxWidth="640" HorizontalAlignment="Left">

                <!-- Appearance -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVisibility}, ConverterParameter=Appearance}">
                    <TextBlock Style="{StaticResource SectionHeader}" FontSize="{StaticResource Font.Size.Title}" Text="Appearance" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Pick a theme. It applies right away." />

                    <ItemsControl ItemsSource="{Binding ThemeChoices}" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!--
                                    The content is a panel, so the control has no readable name of
                                    its own and has to be given one.
                                -->
                                <RadioButton GroupName="Theme"
                                             Margin="0,0,0,10"
                                             AutomationProperties.Name="{Binding DisplayName}"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0" Text="{Binding Description}" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                        A live sample rather than a swatch. Every one of these is a real state brush,
                        so the preview is the same colours the interface uses and cannot drift from
                        them.
                    -->
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="How states look" />

                            <ItemsControl Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                                    <Ellipse Style="{StaticResource StateDot}" Margin="0,0,7,0" Fill="{DynamicResource Accent.Neutral.Brush}" />
                                    <TextBlock Text="pending" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                                    <Ellipse Style="{StaticResource StateDot}" Margin="0,0,7,0" Fill="{DynamicResource Status.Info.Brush}" />
                                    <TextBlock Text="working" Foreground="{DynamicResource Status.Info.Brush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                                    <Ellipse Style="{StaticResource StateDot}" Margin="0,0,7,0" Fill="{DynamicResource Status.Success.Brush}" />
                                    <TextBlock Text="healthy" Foreground="{DynamicResource Status.Success.Brush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                                    <Ellipse Style="{StaticResource StateDot}" Margin="0,0,7,0" Fill="{DynamicResource Status.Warning.Brush}" />
                                    <TextBlock Text="thin" Foreground="{DynamicResource Status.Warning.Brush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                                    <Ellipse Style="{StaticResource StateDot}" Margin="0,0,7,0" Fill="{DynamicResource Status.Danger.Brush}" />
                                    <TextBlock Text="failed" Foreground="{DynamicResource Status.Danger.Brush}" />
                                </StackPanel>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource MonoText}" Foreground="{DynamicResource Diff.Added.Brush}" Text="+34" />
                                <TextBlock Style="{StaticResource MonoText}" Margin="8,0,20,0" Foreground="{DynamicResource Diff.Removed.Brush}" Text="-6" />
                                <TextBlock Style="{StaticResource MonoText}" Text="Assets/Scripts/PlayerMovement.cs" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Rectangle Width="3" Height="18" Margin="0,0,7,0" Fill="{DynamicResource NodeType.Input.Brush}" />
                                <Rectangle Width="3" Height="18" Margin="0,0,7,0" Fill="{DynamicResource NodeType.Plan.Brush}" />
                                <Rectangle Width="3" Height="18" Margin="0,0,7,0" Fill="{DynamicResource NodeType.Model.Brush}" />
                                <Rectangle Width="3" Height="18" Margin="0,0,7,0" Fill="{DynamicResource NodeType.Transform.Brush}" />
                                <Rectangle Width="3" Height="18" Margin="0,0,7,0" Fill="{DynamicResource NodeType.CompileCheck.Brush}" />
                                <Rectangle Width="3" Height="18" Margin="0,0,14,0" Fill="{DynamicResource NodeType.Output.Brush}" />
                                <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Text="the six node accents" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Models -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVisibility}, ConverterParameter=Models}">
                    <TextBlock Style="{StaticResource SectionHeader}" FontSize="{StaticResource Font.Size.Title}" Text="Models" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Add a whole folder to search, or add one model on its own. GGUF and safetensors both show up in the same list." />

                    <!--
                        Three ways in, said plainly, because the shape of the thing you are adding
                        decides which picker can even show it: a folder picker lists folders, so a
                        model file is invisible in one and there has to be a file picker too.
                    -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource SmallButton}"
                                Margin="0,0,8,0"
                                Content="Add model file"
                                ToolTip="One GGUF or safetensors file."
                                Command="{Binding AddModelFileCommand}" />

                        <Button Style="{StaticResource SmallButton}"
                                Margin="0,0,8,0"
                                Content="Add model folder"
                                ToolTip="One safetensors model: a folder holding config.json beside its weights."
                                Command="{Binding AddModelFolderCommand}" />

                        <Button Style="{StaticResource SmallButton}"
                                Margin="0,0,8,0"
                                Content="Search a folder"
                                ToolTip="Look inside this folder, and keep looking, for anything that is a model."
                                Command="{Binding AddFolderCommand}" />

                        <Button Style="{StaticResource SmallButton}"
                                Margin="0,0,8,0"
                                Content="Rescan"
                                Command="{Binding RescanCommand}" />

                        <Button Style="{StaticResource SmallButton}"
                                Content="Edit model-paths.txt"
                                Command="{Binding EditModelPathsCommand}" />
                    </StackPanel>

                    <!-- Whatever the last action did, said here rather than in a dialog. -->
                    <TextBlock Style="{StaticResource HintText}"
                               Foreground="{DynamicResource Text.Primary.Brush}"
                               Text="{Binding CatalogMessage}"
                               Visibility="{Binding CatalogMessage, Converter={StaticResource StringToVisibility}}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Where models come from" />

                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="10,7" Margin="0,0,0,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource LinkButton}"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Content="Remove"
                                                Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding CanRemove, Converter={StaticResource BooleanToVisibility}}" />

                                        <TextBlock DockPanel.Dock="Left"
                                                   FontFamily="{StaticResource Font.Icons}"
                                                   FontSize="{StaticResource Font.Size.Normal}"
                                                   Margin="0,0,10,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Text.Muted.Brush}"
                                                   Text="&#xE8B7;"
                                                   Visibility="{Binding IsFolder, Converter={StaticResource BooleanToVisibility}}" />

                                        <TextBlock DockPanel.Dock="Left"
                                                   FontFamily="{StaticResource Font.Icons}"
                                                   FontSize="{StaticResource Font.Size.Normal}"
                                                   Margin="0,0,10,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Text.Muted.Brush}"
                                                   Text="&#xE7C3;"
                                                   Visibility="{Binding IsFolder, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}" />

                                        <StackPanel>
                                            <TextBlock Style="{StaticResource MonoText}"
                                                       FontSize="{StaticResource Font.Size.Normal}"
                                                       Text="{Binding Label}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Path}" />

                                            <TextBlock Style="{StaticResource MutedText}" Text="{Binding Detail}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource HintText}" Text="{Binding Catalog.SearchSummary}" />

                    <Rectangle Height="1" Margin="0,20,0,0" Fill="{DynamicResource Surface.Border.Brush}" />

                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,16,0,0" Text="Cloud provider" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Used by model nodes you add from now on, so you only type the key once. Nodes you already have keep their own." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Base URL" />
                    <TextBox Text="{Binding CloudBaseUrl, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Style="{StaticResource HintText}" Text="Leave blank to use the provider's own address." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="API key" />
                    <TextBox Text="{Binding CloudApiKey, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Font.Mono}" />
                    <TextBlock Style="{StaticResource HintText}"
                               Foreground="{DynamicResource Status.Warning.Brush}"
                               Text="Stored in plain text in config.json." />
                </StackPanel>

                <!-- Unity -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVisibility}, ConverterParameter=Unity}">
                    <TextBlock Style="{StaticResource SectionHeader}" FontSize="{StaticResource Font.Size.Title}" Text="Unity" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Open project" />
                    <TextBlock Text="{Binding Index.IndexedProject, TargetNullValue=No project is open.}" />
                    <TextBlock Style="{StaticResource HintText}" Text="Change it from File, Open Unity project." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="What is known about it" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource StateDot}"
                                 Margin="0,0,8,0"
                                 Fill="{Binding Index.State, Converter={StaticResource ResourceLookup}, ConverterParameter=ProjectIndexState}" />
                        <TextBlock Text="{Binding Index.StatusText}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource MonoText}"
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource Text.Muted.Brush}"
                               Text="{Binding Index.Stage}" />

                    <Button Style="{StaticResource SmallButton}"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Content="Read the project again"
                            Command="{Binding ReindexCommand}" />

                    <TextBlock Style="{StaticResource HintText}"
                               Text="Only needed if something outside the editor changed a lot of files at once." />
                </StackPanel>

                <!-- Runtime -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVisibility}, ConverterParameter=Runtime}">
                    <TextBlock Style="{StaticResource SectionHeader}" FontSize="{StaticResource Font.Size.Title}" Text="Runtime" />

                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,14,0,0" Text="Python environment" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Ellipse Style="{StaticResource StateDot}"
                                 Margin="0,0,8,0"
                                 Fill="{Binding Python.Environment.State, Converter={StaticResource ResourceLookup}, ConverterParameter=PythonEnvironmentState}" />
                        <TextBlock Text="{Binding Python.Environment.StatusText}" />
                    </StackPanel>

                    <ProgressBar Margin="0,10,0,0"
                                 IsIndeterminate="True"
                                 Visibility="{Binding Python.Environment.IsBusy, Converter={StaticResource BooleanToVisibility}}" />

                    <TextBlock Style="{StaticResource MonoText}"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource Text.Muted.Brush}"
                               TextWrapping="Wrap"
                               Text="{Binding Python.Environment.Stage}" />

                    <TextBlock Style="{StaticResource MonoText}"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource Text.Muted.Brush}"
                               TextWrapping="Wrap"
                               Text="{Binding Python.Environment.Detail}" />

                    <TextBlock Style="{StaticResource HintText}"
                               Foreground="{DynamicResource Field.Error.Brush}"
                               Text="{Binding Python.Environment.LastError}"
                               Visibility="{Binding Python.Environment.LastError, Converter={StaticResource StringToVisibility}}" />

                    <TextBlock Style="{StaticResource HintText}" Text="{Binding Python.Environment.AcceleratorSummary}" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource SmallButton}" Margin="0,0,8,0" Content="Repair" Command="{Binding Python.RepairCommand}" />
                        <Button Style="{StaticResource SmallButton}" Margin="0,0,8,0" Content="Set up again" Command="{Binding Python.ResetCommand}" />
                        <Button Style="{StaticResource SmallButton}" Content="Open its folder" Command="{Binding Python.OpenFolderCommand}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource HintText}"
                               Text="Only needed to run safetensors models. GGUF models work without it." />

                    <Rectangle Height="1" Margin="0,20,0,0" Fill="{DynamicResource Surface.Border.Brush}" />

                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,16,0,0" Text="Mesh node" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Ellipse Style="{StaticResource StateDot}"
                                 Margin="0,0,8,0"
                                 Fill="{Binding Network.Mesh.State, Converter={StaticResource ResourceLookup}, ConverterParameter=MeshNodeState}" />
                        <TextBlock Text="{Binding Network.Mesh.StatusText}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Mesh name" />
                    <TextBox Text="{Binding Network.MeshName, UpdateSourceTrigger=LostFocus}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Join another mesh" />
                    <TextBox Text="{Binding Network.JoinToken, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Font.Mono}" />

                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              Margin="0,14,0,0"
                              Content="Publish this mesh publicly"
                              IsChecked="{Binding Network.Publish}" />

                    <TextBlock Style="{StaticResource HintText}"
                               Foreground="{DynamicResource Status.Warning.Brush}"
                               Text="The only setting that reaches beyond your local network." />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource SmallButton}" Margin="0,0,8,0" Content="Apply and restart the node" Command="{Binding Network.ApplySettingsCommand}" />
                        <Button Style="{StaticResource SmallButton}" Margin="0,0,8,0" Content="Start or stop the node" Command="{Binding Network.ToggleMeshCommand}" />
                        <Button Style="{StaticResource SmallButton}" Content="Leave the mesh" Command="{Binding Network.LeaveMeshCommand}" />
                    </StackPanel>
                </StackPanel>

                <!-- Behaviour -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVisibility}, ConverterParameter=Behaviour}">
                    <TextBlock Style="{StaticResource SectionHeader}" FontSize="{StaticResource Font.Size.Title}" Text="Behaviour" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="What a newly added node starts from. Graphs you have already saved keep their own values." />

                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,16,0,0" Text="Compile check" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Repair attempts after the first failure" />
                    <TextBox Text="{Binding DefaultRetryLimit, UpdateSourceTrigger=LostFocus}" MaxWidth="120" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource HintText}" Text="Zero checks the code without trying to fix it." />

                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Plan context budget" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Project map" />
                            <TextBox Text="{Binding DefaultMapCharacters, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Candidate detail" />
                            <TextBox Text="{Binding DefaultCandidateCharacters, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Signatures this run" />
                            <TextBox Text="{Binding DefaultEmittedCharacters, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Candidate files offered before any is read" />
                    <TextBox Text="{Binding DefaultCandidateLimit, UpdateSourceTrigger=LostFocus}" MaxWidth="120" HorizontalAlignment="Left" />

                    <TextBlock Style="{StaticResource HintText}" Text="{Binding DefaultBudgetSummary}" />

                    <Rectangle Height="1" Margin="0,20,0,0" Fill="{DynamicResource Surface.Border.Brush}" />

                    <Button Style="{StaticResource SmallButton}"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Left"
                            Content="Open this install's data folder"
                            Command="{Binding OpenDataFolderCommand}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
