<UserControl x:Class="LocalNEXUS.App.Views.Shell.SpecView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LocalNEXUS.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!--
        The Spec tab. Changes on the left, the selected change's artifacts in the middle, and
        whichever artifact is being read on the right.

        The application draws all of it and the extension supplies none of it. Nothing here works
        out which artifact comes next or whether a change is finished; those are the questions
        OpenSpec exists to answer and they are asked rather than answered again.

        An artifact that is blocked wears the neutral colour, not the danger one. Blocked is waiting
        its turn, and painting it red would blame it for the artifact in front of it.
    -->

    <Grid DataContext="{Binding Spec}" Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The changes. -->
        <DockPanel Grid.Column="0" Background="{DynamicResource Surface.Panel.Brush}">

            <Border DockPanel.Dock="Top"
                    Padding="12,10"
                    BorderBrush="{DynamicResource Surface.Border.Brush}"
                    BorderThickness="0,0,0,1">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource SmallButton}"
                                Content="Refresh"
                                Command="{Binding RefreshCommand}" />

                        <TextBlock Text="Changes"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold" />
                    </DockPanel>

                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding StatusText}" />

                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Text.Muted.Brush}"
                               Text="{Binding WorkerText}"
                               Visibility="{Binding WorkerText, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </Border>

            <ListBox ItemsSource="{Binding Changes}"
                     SelectedItem="{Binding SelectedChange}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,4">
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource HintText}"
                                       TextWrapping="Wrap"
                                       Text="{Binding Summary}" />
                            <TextBlock Style="{StaticResource HintText}"
                                       Foreground="{DynamicResource Text.Muted.Brush}"
                                       Text="Archived"
                                       Visibility="{Binding Status, Converter={StaticResource EnumToVisibility}, ConverterParameter=Archived}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- The artifacts of the selected change. -->
        <DockPanel Grid.Column="1"
                   Background="{DynamicResource Surface.Panel.Brush}"
                   Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibility}}">

            <Border DockPanel.Dock="Top"
                    Padding="12,10"
                    BorderBrush="{DynamicResource Surface.Border.Brush}"
                    BorderThickness="1,0,0,1">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedChange.Name}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource SmallButton}"
                                Margin="0,0,6,0"
                                Content="Advance"
                                ToolTip="Ask OpenSpec to write the next artifact that is ready."
                                Command="{Binding AdvanceCommand}" />

                        <Button Style="{StaticResource PrimaryButton}"
                                Content="Send tasks to Workspace"
                                ToolTip="Put this change's task list in the request box, whole. Nothing runs until you press Run there."
                                Command="{Binding SendTasksToWorkspaceCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding SelectedChange.Artifacts}" Margin="8,8,8,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,0,4"
                                HorizontalContentAlignment="Left"
                                Padding="8,6"
                                ToolTip="{Binding Detail}"
                                Command="{Binding DataContext.ShowArtifactCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <DockPanel>
                                <Ellipse DockPanel.Dock="Left"
                                         Style="{StaticResource StateDot}"
                                         Width="7"
                                         Height="7"
                                         Margin="0,0,8,0"
                                         Fill="{Binding State, Converter={StaticResource ResourceLookup}, ConverterParameter=SpecArtifactState}" />

                                <TextBlock DockPanel.Dock="Right"
                                           Style="{StaticResource HintText}"
                                           Margin="8,0,0,0"
                                           Text="{Binding State}" />

                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!-- Whichever artifact is being read. -->
        <DockPanel Grid.Column="2">
            <Border DockPanel.Dock="Top"
                    Padding="12,10"
                    BorderBrush="{DynamicResource Surface.Border.Brush}"
                    BorderThickness="1,0,0,1"
                    Visibility="{Binding HasArtifact, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedArtifact.Name}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Text="{Binding ArtifactPath}"
                               Visibility="{Binding ArtifactPath, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource HintText}"
                       Margin="16"
                       TextWrapping="Wrap"
                       VerticalAlignment="Top"
                       Text="Choose a change on the left, then an artifact, to read it here."
                       Visibility="{Binding HasArtifact, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Visibility="{Binding HasArtifact, Converter={StaticResource BooleanToVisibility}}">
                <TextBox Style="{StaticResource MonoTextBox}"
                         Margin="12"
                         Padding="8,6"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         TextWrapping="NoWrap"
                         Text="{Binding ArtifactText, Mode=OneWay}" />
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
