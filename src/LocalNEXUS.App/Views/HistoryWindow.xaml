<Window x:Class="LocalNEXUS.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LocalNEXUS.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}"
        Title="Run history"
        Height="720"
        Width="1180"
        MinHeight="500"
        MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Window.Brush}"
        Foreground="{DynamicResource Text.Primary.Brush}"
        FontFamily="{StaticResource Font.Sans}"
        TextOptions.TextFormattingMode="Ideal">

    <!--
        Runs down the left, the record of one on the right. The list is what was recorded rather
        than a summary of it, and opening a run reads its transcript back from disk in the words it
        was written in.
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search. This is what the index is for, and it is why nothing has to be summarised. -->
        <Border Grid.Row="0"
                Background="{DynamicResource Surface.Chrome.Brush}"
                BorderBrush="{DynamicResource Surface.Border.Brush}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource SmallButton}"
                        MinWidth="80"
                        Margin="8,0,0,0"
                        Content="Search"
                        Command="{Binding RefreshCommand}" />

                <TextBlock DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Text="Find" />

                <Grid>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search the run history">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding RefreshCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <TextBlock Text="Anything said during a run: an error, a file name, a request."
                               Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource Text.Muted.Brush}"
                               Visibility="{Binding SearchText, Converter={StaticResource StringToVisibility}, ConverterParameter=Invert}" />
                </Grid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="280" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- The runs. -->
            <DockPanel Grid.Column="0" Background="{DynamicResource Surface.Panel.Brush}">
                <TextBlock DockPanel.Dock="Top"
                           Style="{StaticResource HintText}"
                           Margin="14,10,14,8"
                           TextWrapping="Wrap"
                           Text="{Binding ListSummary}" />

                <TextBlock DockPanel.Dock="Top"
                           Style="{StaticResource HintText}"
                           Margin="14,0,14,10"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Status.Warning.Brush}"
                           Text="{Binding UnavailableText}"
                           Visibility="{Binding IsAvailable, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}" />

                <ListBox ItemsSource="{Binding Runs}"
                         SelectedItem="{Binding Selected, Mode=OneWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource TableRow}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="Transparent"
                                    Padding="14,8"
                                    InputMethod.IsInputMethodEnabled="False">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Style="{StaticResource HintText}"
                                                   Text="{Binding Duration}" />
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="{Binding StartedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                                    </DockPanel>

                                    <TextBlock Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding RequestLine}" />

                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Ellipse Style="{StaticResource StateDot}"
                                                 Margin="0,0,7,0"
                                                 Fill="{Binding State, Converter={StaticResource ResourceLookup}, ConverterParameter=RunState}" />
                                        <TextBlock Style="{StaticResource HintText}" Text="{Binding State}" />
                                        <TextBlock Style="{StaticResource HintText}" Margin="10,0,0,0" Text="{Binding Produced}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Rectangle Grid.Column="1" Fill="{DynamicResource Surface.Border.Brush}" />

            <!-- The record of the selected run. -->
            <Grid Grid.Column="2">
                <TextBlock Margin="24"
                           TextWrapping="Wrap"
                           VerticalAlignment="Top"
                           Foreground="{DynamicResource Text.Muted.Brush}"
                           Text="Pick a run to read what it did."
                           Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}" />

                <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibility}}">

                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource Surface.Chrome.Brush}"
                            BorderBrush="{DynamicResource Surface.Border.Brush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Text="{Binding Selected.Request}" />

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource SmallButton}"
                                        MinWidth="130"
                                        Content="Undo the files"
                                        Command="{Binding UndoCommand}" />

                                <Button Style="{StaticResource SmallButton}"
                                        MinWidth="130"
                                        Margin="8,0,0,0"
                                        Content="Reuse the request"
                                        Command="{Binding ReuseRequestCommand}" />
                            </StackPanel>

                            <!--
                                Said here rather than left to be found out. Somebody who believes
                                this is version control will discover otherwise at the worst
                                possible moment.
                            -->
                            <TextBlock Style="{StaticResource HintText}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Text="{Binding UndoScopeText}" />

                            <TextBlock Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Status.Info.Brush}"
                                       Text="{Binding UndoSummary}"
                                       Visibility="{Binding UndoSummary, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!-- What it did to files. -->
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{DynamicResource Surface.Border.Brush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,10"
                            Visibility="{Binding Files.Count, Converter={StaticResource CountToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Files}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock DockPanel.Dock="Right"
                                                   Style="{StaticResource HintText}"
                                                   Margin="10,0,0,0"
                                                   Text="{Binding Detail}" />
                                        <TextBlock DockPanel.Dock="Left"
                                                   Style="{StaticResource HintText}"
                                                   Width="70"
                                                   Text="{Binding Outcome}" />
                                        <TextBlock Style="{StaticResource MonoText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Path}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- The transcript, as it happened. -->
                    <ListBox ItemsSource="{Binding Events}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource TableRow}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="16,5">
                                    <TextBlock DockPanel.Dock="Left"
                                               Style="{StaticResource MonoText}"
                                               Width="70"
                                               VerticalAlignment="Top"
                                               Foreground="{DynamicResource Text.Muted.Brush}"
                                               Text="{Binding Time}" />
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" Text="{Binding Title}" />
                                        <TextBlock Style="{StaticResource MonoText}"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Text.Secondary.Brush}"
                                                   Text="{Binding Detail}"
                                                   Visibility="{Binding Detail, Converter={StaticResource StringToVisibility}}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
