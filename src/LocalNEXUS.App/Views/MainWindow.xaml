<Window x:Class="LocalNEXUS.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:LocalNEXUS.App.Infrastructure.Behaviors"
        xmlns:shell="clr-namespace:LocalNEXUS.App.Views.Shell"
        xmlns:views="clr-namespace:LocalNEXUS.App.Views"
        xmlns:vm="clr-namespace:LocalNEXUS.App.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="920"
        Width="1560"
        MinHeight="620"
        MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource Text.Primary.Brush}"
        FontFamily="{StaticResource Font.Sans}"
        TextOptions.TextFormattingMode="Ideal"
        behaviors:WindowCommandsBehavior.IsEnabled="True"
        behaviors:WindowMaximiseBoundsBehavior.IsEnabled="True">

    <!--
        The shell: title bar with the menus, activity bar, side bar, editor area, inspector,
        bottom panel and status bar.

        The window draws its own title bar, which is the only way the menu bar can be part of it
        and the only way the caption can be themed. The caption buttons get their handlers from an
        attached behaviour so that the code behind stays a call to InitializeComponent.

        AllowsTransparency is what lets a theme be seen through, and it is the installer's
        mechanism rather than a second one invented here. The alternative, a Windows 11 system
        backdrop, was tried and measured and does not work on this window: DwmSetWindowAttribute
        accepts the request and reads it back, but WindowChrome with no glass frame leaves the
        window with non client rendering disabled, and the backdrop is drawn into a frame that no
        longer exists. A layered window costs the surface its cheapest presentation path, which is
        the price of the feature and is paid whatever theme is in force.
    -->

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectionCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveGraphCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding LoadGraphCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewGraphCommand}" />
        <KeyBinding Key="Enter" Modifiers="Ctrl" Command="{Binding Feed.RunCommand}" />
        <KeyBinding Key="F5" Command="{Binding Feed.RunCommand}" />
        <KeyBinding Key="F6" Command="{Binding Feed.TogglePauseCommand}" />
        <KeyBinding Key="B" Modifiers="Ctrl" Command="{Binding ToggleSideBarCommand}" />
        <KeyBinding Key="J" Modifiers="Ctrl" Command="{Binding TogglePanelCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding OpenSettingsCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseSettingsCommand}" />
    </Window.InputBindings>

    <!--
        No inset when maximised. There used to be one, compensating for the overhang a framed
        window has, and WindowMaximiseBoundsBehavior now answers WM_GETMINMAXINFO with the work
        area so there is no overhang left to compensate for. Keeping both would show a strip of
        desktop down every edge, which a window that can be seen through would make obvious.
    -->
    <Border x:Name="Root">

        <Grid>

            <!--
                The window's base layer, and the only thing in the shell that is ever less than
                solid. It is a sibling of the content rather than its parent, because opacity on an
                ancestor takes the whole subtree with it and would make the text translucent as
                well. Everything above it paints its own surface and stays opaque, which is what
                keeps a translucent window readable.

                Every theme paints this. Five of them supply three identical stops, so it is a flat
                fill and the opacity resolves to solid, and none of them is a special case here.
            -->
            <Border Background="{DynamicResource Surface.Gradient.Brush}"
                    Opacity="{Binding Themes.EffectiveWindowOpacity}" />

            <DockPanel>

                <!-- Title bar -->
                <Border DockPanel.Dock="Top"
                        Height="30"
                        Background="{DynamicResource Surface.Chrome.Brush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--
                            The brand mark. Linked in by Directory.Build.props under a fixed name, so
                            changing which concept the product wears never touches this file.
                        -->
                        <Image Grid.Column="0"
                               Width="18" Height="18"
                               Margin="8,0,6,0"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="/Assets/Brand/Mark.png" />

                        <Menu Grid.Column="1"
                              Background="Transparent"
                              VerticalAlignment="Center"
                              WindowChrome.IsHitTestVisibleInChrome="True">

                            <MenuItem Header="_File">
                                <MenuItem Header="_New graph" InputGestureText="Ctrl+N" Command="{Binding NewGraphCommand}" />
                                <MenuItem Header="_Open graph..." InputGestureText="Ctrl+O" Command="{Binding LoadGraphCommand}" />
                                <MenuItem Header="_Save graph..." InputGestureText="Ctrl+S" Command="{Binding SaveGraphCommand}" />
                                <Separator />
                                <MenuItem Header="Open _Unity project..." Command="{Binding OpenUnityProjectCommand}" />
                                <Separator />
                                <MenuItem Header="Se_ttings" InputGestureText="Ctrl+," Command="{Binding OpenSettingsCommand}" />
                                <Separator />
                                <MenuItem Header="E_xit" Command="{x:Static SystemCommands.CloseWindowCommand}" />
                            </MenuItem>

                            <MenuItem Header="_Edit">
                                <MenuItem Header="_Add node"
                                          ItemsSource="{Binding NodePalette}"
                                          IsEnabled="{Binding IsWorkspace}">
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                            <Setter Property="Header" Value="{Binding DisplayName}" />
                                            <Setter Property="ToolTip" Value="{Binding Description}" />
                                            <Setter Property="Command" Value="{Binding Command}" />
                                            <Setter Property="CommandParameter" Value="{Binding TypeKey}" />
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="_Delete selected" InputGestureText="Del" Command="{Binding DeleteSelectionCommand}" />
                            </MenuItem>

                            <MenuItem Header="_View">
                                <MenuItem Header="_Workspace" Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static vm:PrimarySection.Workspace}" />
                                <MenuItem Header="_Network" Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static vm:PrimarySection.Network}" />
                                <Separator />
                                <MenuItem Header="Toggle _side bar" InputGestureText="Ctrl+B" Command="{Binding ToggleSideBarCommand}" />
                                <MenuItem Header="Toggle _inspector" Command="{Binding ToggleInspectorCommand}" />
                                <MenuItem Header="Toggle _panel" InputGestureText="Ctrl+J" Command="{Binding TogglePanelCommand}" />
                                <Separator />
                                <MenuItem Header="_Problems" Command="{Binding ShowPanelTabCommand}" CommandParameter="{x:Static vm:BottomPanelTab.Problems}" />
                                <MenuItem Header="_Activity" Command="{Binding ShowPanelTabCommand}" CommandParameter="{x:Static vm:BottomPanelTab.Activity}" />
                                <MenuItem Header="_Output" Command="{Binding ShowPanelTabCommand}" CommandParameter="{x:Static vm:BottomPanelTab.Output}" />
                            </MenuItem>

                            <MenuItem Header="_Run">
                                <MenuItem Header="_Run graph" InputGestureText="Ctrl+Enter" Command="{Binding Feed.RunCommand}" />
                                <MenuItem Header="_Pause or resume" InputGestureText="F6" Command="{Binding Feed.TogglePauseCommand}" />
                                <MenuItem Header="_Stop" Command="{Binding Feed.CancelCommand}" />
                                <Separator />
                                <MenuItem Header="_Clear the transcript" Command="{Binding Feed.ClearFeedCommand}" />
                            </MenuItem>
                        </Menu>

                        <TextBlock Grid.Column="2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource MonoText}"
                                   Foreground="{DynamicResource Text.Muted.Brush}"
                                   Text="{Binding WindowTitle}"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Run controls, which say what the run is doing rather than only offering Run. -->
                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"
                                    WindowChrome.IsHitTestVisibleInChrome="True">

                            <TextBlock VerticalAlignment="Center"
                                       Margin="0,0,10,0"
                                       FontSize="{StaticResource Font.Size.Small}"
                                       Foreground="{DynamicResource Status.Danger.Brush}"
                                       Text="Run faulted"
                                       Visibility="{Binding Feed.RunState, Converter={StaticResource EnumToVisibility}, ConverterParameter=Faulted}" />

                            <Button Style="{StaticResource SmallButton}"
                                    Margin="0,0,6,0"
                                    MinWidth="60"
                                    Content="{Binding Feed.PauseButtonText}"
                                    Command="{Binding Feed.TogglePauseCommand}"
                                    Visibility="{Binding Feed.IsRunning, Converter={StaticResource BooleanToVisibility}}" />

                            <Button Style="{StaticResource DangerButton}"
                                    MinWidth="60"
                                    Content="Stop"
                                    Command="{Binding Feed.CancelCommand}"
                                    Visibility="{Binding Feed.IsRunning, Converter={StaticResource BooleanToVisibility}}" />

                            <Button Style="{StaticResource PrimaryButton}"
                                    MinWidth="60"
                                    Padding="12,3"
                                    FontSize="{StaticResource Font.Size.Small}"
                                    Content="Run"
                                    Command="{Binding Feed.RunCommand}"
                                    Visibility="{Binding Feed.IsRunning, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4"
                                    Orientation="Horizontal"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Style="{StaticResource WindowButton}"
                                    Content="&#xE921;"
                                    ToolTip="Minimise"
                                    AutomationProperties.Name="Minimise"
                                    Command="{x:Static SystemCommands.MinimizeWindowCommand}" />

                            <Button Style="{StaticResource WindowButton}"
                                    Content="&#xE922;"
                                    ToolTip="Maximise"
                                    AutomationProperties.Name="Maximise"
                                    Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                                    Visibility="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=!Maximized}" />

                            <Button Style="{StaticResource WindowButton}"
                                    Content="&#xE923;"
                                    ToolTip="Restore"
                                    AutomationProperties.Name="Restore"
                                    Command="{x:Static SystemCommands.RestoreWindowCommand}"
                                    Visibility="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Maximized}" />

                            <Button Style="{StaticResource WindowCloseButton}"
                                    Content="&#xE8BB;"
                                    ToolTip="Close"
                                    AutomationProperties.Name="Close"
                                    Command="{x:Static SystemCommands.CloseWindowCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Status bar -->
                <shell:StatusBarView DockPanel.Dock="Bottom" />

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="220" />
                        <RowDefinition Height="Auto" />
                        <!--
                            Bound two way so the splitter writes the dragged height back to the view
                            model. That is what lets hiding the panel collapse this row to nothing and
                            showing it again return to the size it was left at.
                        -->
                        <RowDefinition Height="{Binding PanelRowHeight, Mode=TwoWay}" MinHeight="0" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="320" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <shell:ActivityBarView Grid.Column="0" />

                        <!--
                            The left panel and the strip that collapses it.

                            The strip is inside the same column, docked to the inner edge, so it is
                            what remains when the panel goes and the chevron does not move when it
                            does. LeftPanel is whichever of the four this tab owns, which is why the
                            layout is written once for two slots rather than twice for four.
                        -->
                        <DockPanel Grid.Column="1">
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource PanelStrip}"
                                    Content="{Binding LeftPanel.Chevron}"
                                    ToolTip="{Binding LeftPanel.ToggleTip}"
                                    AutomationProperties.Name="{Binding LeftPanel.ToggleTip}"
                                    Command="{Binding LeftPanel.ToggleCommand}" />

                            <Grid Width="264"
                                  Visibility="{Binding LeftPanel.IsExpanded, Converter={StaticResource BooleanToVisibility}}">
                                <shell:WorkspaceSideBarView Visibility="{Binding IsWorkspace, Converter={StaticResource BooleanToVisibility}}" />
                                <shell:NetworkSideBarView DataContext="{Binding Network}"
                                                          Visibility="{Binding DataContext.IsNetwork, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}" />
                            </Grid>
                        </DockPanel>

                        <GridSplitter Grid.Column="2"
                                      Width="1"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      ResizeBehavior="PreviousAndNext"
                                      Visibility="{Binding LeftPanel.IsExpanded, Converter={StaticResource BooleanToVisibility}}" />

                        <Grid Grid.Column="3">
                            <shell:EditorAreaView Visibility="{Binding IsWorkspace, Converter={StaticResource BooleanToVisibility}}" />
                            <views:NetworkView DataContext="{Binding Network}"
                                               Visibility="{Binding DataContext.IsNetwork, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}" />
                        </Grid>

                        <GridSplitter Grid.Column="4"
                                      Width="1"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      ResizeBehavior="PreviousAndNext"
                                      Visibility="{Binding RightPanel.IsExpanded, Converter={StaticResource BooleanToVisibility}}" />

                        <!-- One inspector, serving both sections, and the mirror of the strip opposite. -->
                        <DockPanel Grid.Column="5">
                            <Button DockPanel.Dock="Left"
                                    Style="{StaticResource PanelStrip}"
                                    Content="{Binding RightPanel.Chevron}"
                                    ToolTip="{Binding RightPanel.ToggleTip}"
                                    AutomationProperties.Name="{Binding RightPanel.ToggleTip}"
                                    Command="{Binding RightPanel.ToggleCommand}" />

                            <shell:InspectorView Width="340"
                                                 Visibility="{Binding RightPanel.IsExpanded, Converter={StaticResource BooleanToVisibility}}" />
                        </DockPanel>
                    </Grid>

                    <GridSplitter Grid.Row="1"
                                  Height="4"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext"
                                  Visibility="{Binding IsPanelShowing, Converter={StaticResource BooleanToVisibility}}" />

                    <!--
                        The panel and the chat box belong to the Workspace. The Network has neither,
                        because there is no run to transcribe and nothing to type a request at.
                    -->
                    <shell:BottomPanelView Grid.Row="2"
                                           Visibility="{Binding IsPanelShowing, Converter={StaticResource BooleanToVisibility}}" />

                    <Border Grid.Row="3"
                            Background="{DynamicResource Surface.Panel.Brush}"
                            BorderBrush="{DynamicResource Surface.Border.Brush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,10"
                            Visibility="{Binding IsChatShowing, Converter={StaticResource BooleanToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding Feed.RequestText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="34"
                                     MaxHeight="120"
                                     Padding="10,7" />

                            <Button Grid.Column="2"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="96"
                                    VerticalAlignment="Stretch"
                                    Content="Run"
                                    Command="{Binding Feed.RunCommand}" />
                        </Grid>
                    </Border>

                    <!--
                        Settings opens over whatever is showing and closes back onto it, because it is
                        about the application rather than about a thing being worked on, and coming
                        back from it should land where the work was left.
                    -->
                    <Grid Grid.Row="0"
                          Grid.RowSpan="4"
                          Background="{DynamicResource Surface.Scrim.Brush}"
                          Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibility}}">

                        <Border Margin="60,30"
                                MaxWidth="1000"
                                Background="{DynamicResource Surface.Window.Brush}"
                                BorderBrush="{DynamicResource Surface.Border.Brush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <DockPanel>
                                <Border DockPanel.Dock="Top"
                                        Background="{DynamicResource Surface.Chrome.Brush}"
                                        BorderBrush="{DynamicResource Surface.Border.Brush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="16,8"
                                        CornerRadius="6,6,0,0">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource IconButton}"
                                                Content="&#xE8BB;"
                                                ToolTip="Close settings"
                                                AutomationProperties.Name="Close settings"
                                                Command="{Binding CloseSettingsCommand}" />

                                        <TextBlock Text="Settings"
                                                   FontWeight="SemiBold"
                                                   FontSize="{StaticResource Font.Size.Large}"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>

                                <views:SettingsView DataContext="{Binding Settings}" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </DockPanel>
        </Grid>
    </Border>
</Window>
