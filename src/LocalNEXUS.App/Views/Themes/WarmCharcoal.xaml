<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Warm charcoal. Softer contrast than the others, which suits long sessions. -->

    <Color x:Key="Surface.WindowColor">#FF282C34</Color>
    <Color x:Key="Surface.PanelColor">#FF21252B</Color>
    <Color x:Key="Surface.CardColor">#FF2C313A</Color>
    <Color x:Key="Surface.InputColor">#FF1B1F27</Color>
    <Color x:Key="Surface.BorderColor">#FF3E4451</Color>
    <Color x:Key="Surface.ChromeColor">#FF21252B</Color>
    <Color x:Key="Surface.HoverColor">#FF2C313A</Color>
    <Color x:Key="Surface.SelectedColor">#FF3A4250</Color>
    <Color x:Key="Surface.TrackColor">#FF353B45</Color>
    <Color x:Key="Surface.ScrimColor">#B2000000</Color>

    <Color x:Key="Text.PrimaryColor">#FFABB2BF</Color>
    <Color x:Key="Text.SecondaryColor">#FF959CAA</Color>
    <Color x:Key="Text.MutedColor">#FF7F848E</Color>
    <Color x:Key="Text.InverseColor">#FF1B1F27</Color>

    <Color x:Key="Accent.PrimaryColor">#FF61AFEF</Color>
    <Color x:Key="Accent.NeutralColor">#FF6B7280</Color>

    <Color x:Key="Status.SuccessColor">#FF98C379</Color>
    <Color x:Key="Status.InfoColor">#FF61AFEF</Color>
    <Color x:Key="Status.DangerColor">#FFE06C75</Color>
    <Color x:Key="Status.WarningColor">#FFE5C07B</Color>

    <Color x:Key="Diff.AddedColor">#FF98C379</Color>
    <Color x:Key="Diff.RemovedColor">#FFE06C75</Color>

    <Color x:Key="NodeType.InputColor">#FF61AFEF</Color>
    <Color x:Key="NodeType.PlanColor">#FF56B6C2</Color>
    <Color x:Key="NodeType.ModelColor">#FFC678DD</Color>
    <Color x:Key="NodeType.TransformColor">#FF98C379</Color>
    <Color x:Key="NodeType.CompileColor">#FFE06C75</Color>
    <Color x:Key="NodeType.OutputColor">#FFE5C07B</Color>

    <Color x:Key="Pin.TextColor">#FF61AFEF</Color>
    <Color x:Key="Pin.CodeColor">#FFD19A66</Color>

</ResourceDictionary>
