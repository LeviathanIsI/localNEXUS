<UserControl x:Class="LocalNEXUS.App.Views.Settings.PatchNodeSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodes="clr-namespace:LocalNEXUS.App.Nodes"
             d:DataContext="{d:DesignInstance Type=nodes:PatchNode}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <StackPanel>
        <TextBlock Style="{StaticResource SectionHeader}" Text="Mode" />
        <TextBlock Style="{StaticResource HintText}"
                   TextWrapping="Wrap"
                   Text="How a rule is expressed. It applies to the rule typed below and to one arriving on the Rule pin, which is read as this form unless it says otherwise." />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <RadioButton Content="Pattern"
                         GroupName="PatchMode"
                         IsChecked="{Binding Mode, Converter={StaticResource EnumToBoolean}, ConverterParameter=Regex}" />
            <RadioButton Content="Template"
                         GroupName="PatchMode"
                         Margin="12,0,0,0"
                         IsChecked="{Binding Mode, Converter={StaticResource EnumToBoolean}, ConverterParameter=Template}" />
            <RadioButton Content="Script"
                         GroupName="PatchMode"
                         Margin="12,0,0,0"
                         IsChecked="{Binding Mode, Converter={StaticResource EnumToBoolean}, ConverterParameter=Script}" />
        </StackPanel>

        <!--
            Pattern mode, and the default. It needs nothing but the regular expression engine,
            which is what makes it the one that survives a single file build.
        -->
        <StackPanel Visibility="{Binding IsRegexMode, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Pattern" />
            <TextBox Style="{StaticResource MonoTextBox}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="60"
                     Text="{Binding RegexPattern, UpdateSourceTrigger=LostFocus}" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Replace with" />
            <TextBox Style="{StaticResource MonoTextBox}"
                     Text="{Binding RegexReplacement, UpdateSourceTrigger=LostFocus}" />

            <TextBlock Style="{StaticResource HintText}"
                       TextWrapping="Wrap"
                       Text="The default strips a markdown code fence off a model reply and leaves anything else alone. A pattern that matches nothing passes the code through; one that will not compile fails the node." />
        </StackPanel>

        <!-- Template mode -->
        <StackPanel Visibility="{Binding IsTemplateMode, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Template" />
            <TextBox Style="{StaticResource MonoTextBox}"
                     Text="{Binding Template, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="110"
                     MaxHeight="240" />
            <TextBlock Style="{StaticResource HintText}"
                       Text="Every occurrence of {{input}} is replaced with the incoming value, then the pairs below are applied in order." />

            <Grid Margin="0,16,0,4">
                <TextBlock Style="{StaticResource SectionHeader}" Text="Find and replace" VerticalAlignment="Center" />
                <Button Style="{StaticResource SmallButton}"
                        Content="Add pair"
                        HorizontalAlignment="Right"
                        Command="{Binding AddReplacementCommand}" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Replacements}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     FontFamily="{StaticResource Font.Mono}"
                                     FontSize="{StaticResource Font.Size.Small}"
                                     Text="{Binding Find, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="2"
                                     FontFamily="{StaticResource Font.Mono}"
                                     FontSize="{StaticResource Font.Size.Small}"
                                     Text="{Binding Replace, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="4"
                                    Style="{StaticResource SmallButton}"
                                    Content="Remove"
                                    CommandParameter="{Binding}"
                                    Command="{Binding DataContext.RemoveReplacementCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Script mode -->
        <StackPanel Visibility="{Binding IsScriptMode, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="C# expression" />
            <TextBox Style="{StaticResource MonoTextBox}"
                     Text="{Binding ScriptExpression, UpdateSourceTrigger=LostFocus}"
                     MinHeight="150"
                     MaxHeight="300" />
            <TextBlock Style="{StaticResource HintText}"
                       Text="One C# expression. The incoming text is input, and the result is sent on. Regex, Linq and the usual System namespaces are available." />
            <TextBlock Style="{StaticResource HintText}"
                       Text="Errors show in the activity feed when the node runs." />
        </StackPanel>
    </StackPanel>
</UserControl>
