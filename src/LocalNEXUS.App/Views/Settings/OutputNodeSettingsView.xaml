<UserControl x:Class="LocalNEXUS.App.Views.Settings.OutputNodeSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodes="clr-namespace:LocalNEXUS.App.Nodes"
             d:DataContext="{d:DesignInstance Type=nodes:OutputNode}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <StackPanel>
        <TextBlock Style="{StaticResource SectionHeader}" Text="Destination" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Target subfolder (relative to the Unity project)" />
        <TextBox Text="{Binding TargetSubfolder, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="File name" />
        <TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Resolved path" />
        <Border Style="{StaticResource Card}" Padding="8,6">
            <TextBlock Text="{Binding RelativePathPreview}"
                       FontFamily="{StaticResource Font.Mono}"
                       FontSize="{StaticResource Font.Size.Small}"
                       TextWrapping="Wrap" />
        </Border>

        <CheckBox Margin="0,14,0,0"
                  Content="Ask in the feed before writing"
                  IsChecked="{Binding AskBeforeWriting}" />

        <TextBlock Style="{StaticResource HintText}"
                   Text="The file is created if it does not exist and overwritten if it does. Paths that would resolve outside the opened project are refused." />
    </StackPanel>
</UserControl>
