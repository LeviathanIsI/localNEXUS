<UserControl x:Class="LocalNEXUS.App.Views.Settings.PlanNodeSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodes="clr-namespace:LocalNEXUS.App.Nodes"
             d:DataContext="{d:DesignInstance Type=nodes:PlanNode}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <StackPanel>
        <TextBlock Style="{StaticResource SectionHeader}" Text="What it reads" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Candidate files" />
        <TextBox Text="{Binding CandidateLimit, UpdateSourceTrigger=LostFocus}" />
        <TextBlock Style="{StaticResource HintText}"
                   Text="How many of the project's files are offered as relevant before any of them is read. Ranking is by name and member matches, spread through the reference graph, so a file the request never names but everything relevant depends on still surfaces." />

        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Context budget" />

        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Project map" />
                <TextBox Text="{Binding MapCharacters, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Candidate detail" />
                <TextBox Text="{Binding CandidateCharacters, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
        </Grid>

        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,4" Text="Signatures from this run" />
        <TextBox Text="{Binding EmittedCharacters, UpdateSourceTrigger=LostFocus}" />

        <TextBlock Style="{StaticResource HintText}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Text="{Binding BudgetSummary}" />

        <TextBlock Style="{StaticResource HintText}"
                   Text="In characters, roughly four to a token. Whatever does not fit is dropped in rank order rather than cut in half, and the run says what was left out." />

        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Last plan" />

        <Border Margin="0,6,0,0"
                Padding="10,8"
                CornerRadius="4"
                Background="{DynamicResource Surface.Window.Brush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource Surface.Border.Brush}">
            <StackPanel>
                <TextBlock TextWrapping="Wrap"
                           FontSize="{StaticResource Font.Size.Small}"
                           Foreground="{DynamicResource Text.Secondary.Brush}"
                           Text="What was decided about files that already exist" />

                <TextBox Margin="0,6,0,0"
                         MaxHeight="140"
                         IsReadOnly="True"
                         Style="{StaticResource MonoTextBox}"
                         Text="{Binding LastDecisions, Mode=OneWay}"
                         Visibility="{Binding LastDecisions, Converter={StaticResource StringToVisibility}}" />

                <TextBlock Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           FontSize="{StaticResource Font.Size.Small}"
                           Foreground="{DynamicResource Text.Secondary.Brush}"
                           Text="Files to write, in the order they will be written" />

                <TextBox Margin="0,6,0,0"
                         MaxHeight="180"
                         IsReadOnly="True"
                         Style="{StaticResource MonoTextBox}"
                         Text="{Binding LastPlan, Mode=OneWay}"
                         Visibility="{Binding LastPlan, Converter={StaticResource StringToVisibility}}" />

                <!-- What the index refused to let the planner create, which is the anti duplication rule at work. -->
                <TextBlock Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           FontSize="{StaticResource Font.Size.Small}"
                           Foreground="{DynamicResource Field.Error.Brush}"
                           Text="{Binding LastBlocked}"
                           Visibility="{Binding LastBlocked, Converter={StaticResource StringToVisibility}}" />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource HintText}"
                   Margin="0,10,0,0"
                   Text="This node plans with whichever Model node is wired downstream of it, under a planner's instructions rather than that node's own. Wire it as Request, Plan, Model, Compile check, Write file." />
    </StackPanel>
</UserControl>
