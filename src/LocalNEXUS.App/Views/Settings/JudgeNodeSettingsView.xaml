<UserControl x:Class="LocalNEXUS.App.Views.Settings.JudgeNodeSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodes="clr-namespace:LocalNEXUS.App.Nodes"
             d:DataContext="{d:DesignInstance Type=nodes:JudgeNode}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <StackPanel>
        <TextBlock Style="{StaticResource HintText}"
                   TextWrapping="Wrap"
                   Text="Reads what arrives and makes the determination. Wire a debate into the Text pin for a third opinion however well its models agreed, or two model nodes into Text and Second for a plain second opinion with none of the rounds." />

        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="How it decides" />

        <StackPanel Margin="0,6,0,0">
            <RadioButton Content="Decide independently"
                         GroupName="JudgeMode"
                         Margin="0,0,0,4"
                         ToolTip="Read both, then write its own, informed by both and bound to neither."
                         IsChecked="{Binding Mode, Converter={StaticResource EnumToBoolean}, ConverterParameter=DecideIndependently}" />
            <RadioButton Content="Choose a side"
                         GroupName="JudgeMode"
                         Margin="0,0,0,4"
                         ToolTip="Pick the better position and write it up."
                         IsChecked="{Binding Mode, Converter={StaticResource EnumToBoolean}, ConverterParameter=ChooseASide}" />
            <RadioButton Content="Combine both"
                         GroupName="JudgeMode"
                         ToolTip="Merge the two into one position."
                         IsChecked="{Binding Mode, Converter={StaticResource EnumToBoolean}, ConverterParameter=Combine}" />
        </StackPanel>

        <TextBlock Style="{StaticResource HintText}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Text="Deciding independently is the default. Wiring a judge deliberately is asking for a determination rather than an arbitration: choosing a side throws away half the reasoning that was just paid for, and combining tends to produce a position neither model would defend. The fallback judge inside a debate defaults to combining, for exactly the opposite reason." />

        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="What it said" />
        <TextBox Style="{StaticResource MonoTextBox}"
                 Margin="0,6,0,0"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MaxHeight="260"
                 VerticalScrollBarVisibility="Auto"
                 Text="{Binding LastVerdict, Mode=OneWay}" />
    </StackPanel>
</UserControl>
