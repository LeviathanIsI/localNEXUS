<UserControl x:Class="LocalNEXUS.App.Views.Settings.ModelNodeSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodes="clr-namespace:LocalNEXUS.App.Nodes"
             d:DataContext="{d:DesignInstance Type=nodes:ModelNode}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <StackPanel>
        <TextBlock Style="{StaticResource SectionHeader}" Text="Provider" />
        <WrapPanel Margin="0,6,0,0">
            <RadioButton Content="Local"
                         GroupName="Provider"
                         Margin="0,0,0,4"
                         IsChecked="{Binding Provider, Converter={StaticResource EnumToBoolean}, ConverterParameter=Local}" />
            <RadioButton Content="Network"
                         GroupName="Provider"
                         Margin="0,0,0,4"
                         IsChecked="{Binding Provider, Converter={StaticResource EnumToBoolean}, ConverterParameter=Network}" />
            <RadioButton Content="Self hosted"
                         GroupName="Provider"
                         Margin="0,0,0,4"
                         IsChecked="{Binding Provider, Converter={StaticResource EnumToBoolean}, ConverterParameter=SelfHosted}" />
            <RadioButton Content="OpenRouter"
                         GroupName="Provider"
                         Margin="0,0,0,4"
                         IsChecked="{Binding Provider, Converter={StaticResource EnumToBoolean}, ConverterParameter=OpenRouter}" />
        </WrapPanel>

        <!-- Local model selection -->
        <StackPanel Visibility="{Binding IsLocal, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Local model (GGUF)" />
            <ComboBox ItemsSource="{Binding Catalog.Models}"
                      SelectedItem="{Binding SelectedLocalModel}"
                      DisplayMemberPath="DisplayName" />

            <TextBlock Style="{StaticResource HintText}"
                       Text="{Binding DataContext.Catalog.SearchSummary, RelativeSource={RelativeSource AncestorType=Window}}" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Style="{StaticResource SmallButton}"
                        Content="Add folder"
                        Margin="0,0,6,0"
                        Command="{Binding DataContext.Catalog.AddFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button Style="{StaticResource SmallButton}"
                        Content="Rescan"
                        Margin="0,0,6,0"
                        Command="{Binding DataContext.Catalog.RefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button Style="{StaticResource SmallButton}"
                        Content="Open models folder"
                        Command="{Binding DataContext.Catalog.OpenModelsFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Context size" />
                    <TextBox Text="{Binding ContextSize, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="GPU layers" />
                    <TextBox Text="{Binding GpuLayers, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource HintText}"
                       Text="Applied when LocalNEXUS starts the server for this model. 999 layers means offload everything." />

            <TextBlock Style="{StaticResource HintText}"
                       Margin="0,10,0,0"
                       Text="A local model runs on this machine alone. To run one across machines, switch this node to the network provider and pick a model the mesh serves." />
        </StackPanel>

        <!-- Network served model -->
        <StackPanel Visibility="{Binding IsNetwork, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Network model" />
            <ComboBox ItemsSource="{Binding Mesh.Models}"
                      SelectedItem="{Binding SelectedNetworkModel}">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsComplete}" Value="False">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource Font.Size.Small}"
                                       Text="{Binding StatusText}"
                                       Foreground="{Binding Strength, Converter={StaticResource ResourceLookup}, ConverterParameter=SectionCoverage}" />
                            <TextBlock Text="{Binding DisplayLabel}" VerticalAlignment="Center" />
                        </DockPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Style="{StaticResource HintText}"
                       Text="Models the mesh can serve right now, from the Network tab. Blocked models cannot be picked; the tab shows which section is at fault. Whether the model runs on one machine or as layer stages across several is the mesh's decision, made at run time." />
        </StackPanel>

        <!-- Self hosted server -->
        <StackPanel Visibility="{Binding IsSelfHosted, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Model id" />
            <TextBox Text="{Binding SelfHostedModelId, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource Font.Mono}" />
            <TextBlock Style="{StaticResource HintText}"
                       Text="The model name your server expects in requests. Set the server's address under Endpoint below; nothing is spawned." />

            <TextBlock Style="{StaticResource FieldLabel}" Text="API key (optional)" />
            <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource Font.Mono}" />
            <TextBlock Style="{StaticResource HintText}"
                       Text="Sent as a bearer token when your server requires one. Stored in plain text inside the saved graph file." />
        </StackPanel>

        <!-- OpenRouter model selection -->
        <StackPanel Visibility="{Binding IsOpenRouter, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="OpenRouter model slug" />
            <TextBox Text="{Binding OpenRouterModel, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource Font.Mono}" />
            <TextBlock Style="{StaticResource HintText}"
                       Text="For example anthropic/claude-sonnet-4 or meta-llama/llama-3.3-70b-instruct" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="API key" />
            <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource Font.Mono}" />
            <TextBlock Style="{StaticResource HintText}"
                       Text="Stored in plain text inside the saved graph file. Keep shared graphs free of keys." />
        </StackPanel>

        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Prompt" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="System prompt" />
        <TextBox Style="{StaticResource MonoTextBox}"
                 Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="120"
                 MaxHeight="260" />

        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Sampling" />

        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Temperature" />
                <TextBox Text="{Binding Temperature, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Max tokens" />
                <TextBox Text="{Binding MaxTokens, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
        </Grid>

        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Endpoint" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Base URL" />
        <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                 FontFamily="{StaticResource Font.Mono}" />
        <TextBlock Style="{StaticResource HintText}"
                   Text="Leave blank for a local model and LocalNEXUS starts and reuses its own servers, splitting across sources when needed. Set it to point this node at a server that is already running; nothing is spawned then." />
    </StackPanel>
</UserControl>
