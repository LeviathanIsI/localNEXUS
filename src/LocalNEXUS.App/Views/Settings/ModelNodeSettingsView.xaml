<UserControl x:Class="LocalNEXUS.App.Views.Settings.ModelNodeSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodes="clr-namespace:LocalNEXUS.App.Nodes"
             d:DataContext="{d:DesignInstance Type=nodes:ModelNode}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <StackPanel>
        <TextBlock Style="{StaticResource SectionHeader}" Text="Provider" />
        <WrapPanel Margin="0,6,0,0">
            <RadioButton Content="Local"
                         GroupName="Provider"
                         Margin="0,0,0,4"
                         IsChecked="{Binding Provider, Converter={StaticResource EnumToBoolean}, ConverterParameter=Local}" />
            <RadioButton Content="Network"
                         GroupName="Provider"
                         Margin="0,0,0,4"
                         IsChecked="{Binding Provider, Converter={StaticResource EnumToBoolean}, ConverterParameter=Network}" />
            <RadioButton Content="Self hosted"
                         GroupName="Provider"
                         Margin="0,0,0,4"
                         IsChecked="{Binding Provider, Converter={StaticResource EnumToBoolean}, ConverterParameter=SelfHosted}" />
            <RadioButton Content="OpenRouter"
                         GroupName="Provider"
                         Margin="0,0,0,4"
                         IsChecked="{Binding Provider, Converter={StaticResource EnumToBoolean}, ConverterParameter=OpenRouter}" />
        </WrapPanel>

        <!-- Local model selection -->
        <StackPanel Visibility="{Binding IsLocal, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Local model" />
            <ComboBox ItemsSource="{Binding Catalog.Models}"
                      SelectedItem="{Binding SelectedLocalModel}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Format is on the right as a label. It is information, not a choice. -->
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource Font.Size.Small}"
                                       Foreground="{DynamicResource Text.Secondary.Brush}"
                                       Text="{Binding FormatLabel}" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </DockPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Style="{StaticResource HintText}"
                       Text="{Binding DataContext.Catalog.SearchSummary, RelativeSource={RelativeSource AncestorType=Window}}" />

            <WrapPanel Margin="0,8,0,0">
                <Button Style="{StaticResource SmallButton}"
                        Content="Add folder"
                        Margin="0,0,6,4"
                        Command="{Binding DataContext.Catalog.AddFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button Style="{StaticResource SmallButton}"
                        Content="Rescan"
                        Margin="0,0,6,4"
                        Command="{Binding DataContext.Catalog.RefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button Style="{StaticResource SmallButton}"
                        Margin="0,0,6,4"
                        Content="Open models folder"
                        Command="{Binding DataContext.Catalog.OpenModelsFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button Style="{StaticResource SmallButton}"
                        Margin="0,0,0,4"
                        Content="Edit model folders"
                        ToolTip="Opens model-paths.txt, one folder per line, scanned for both formats"
                        Command="{Binding DataContext.Catalog.EditModelPathsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </WrapPanel>

            <!-- Which of the two selections this node actually runs, said plainly. -->
            <Border Margin="0,10,0,0"
                    Padding="10,8"
                    CornerRadius="4"
                    Background="{DynamicResource Surface.Window.Brush}"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource Surface.Border.Brush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsModelFileMissing}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Field.Error.Brush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <TextBlock TextWrapping="Wrap"
                               FontSize="{StaticResource Font.Size.Small}"
                               Text="{Binding ModelSourceText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary.Brush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsModelFileMissing}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Field.Error.Brush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- The full path is on the tooltip, because the panel is too narrow for most of them. -->
                    <TextBlock Margin="0,6,0,0"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="{StaticResource Font.Size.Small}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding ModelFilePath}"
                               ToolTip="{Binding ModelFilePath}"
                               Visibility="{Binding HasModelFile, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary.Brush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsModelFileMissing}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Field.Error.Brush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <WrapPanel Margin="0,8,0,0">
                        <Button Style="{StaticResource SmallButton}"
                                Margin="0,0,6,4"
                                Content="Browse for a file"
                                ToolTip="Run a GGUF from anywhere on disk for this node only, without adding its folder to the catalogue"
                                Command="{Binding BrowseForModelFileCommand}" />
                        <Button Style="{StaticResource SmallButton}"
                                Margin="0,0,6,4"
                                Content="Browse for a folder"
                                ToolTip="A safetensors model is a folder holding config.json beside its weight files, so it is picked as a folder"
                                Command="{Binding BrowseForModelFolderCommand}" />
                        <Button Style="{StaticResource SmallButton}"
                                Margin="0,0,0,4"
                                Content="Use the catalogue"
                                ToolTip="Drop this node's own model and go back to the selection above"
                                Command="{Binding ClearModelFileCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Context size" />
                    <TextBox Text="{Binding ContextSize, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="GPU layers" />
                    <TextBox Text="{Binding GpuLayers, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource HintText}"
                       Text="Applied when LocalNEXUS starts the server for this model. 999 layers means offload everything." />

            <TextBlock Style="{StaticResource HintText}"
                       Margin="0,10,0,0"
                       Text="A local model runs on this machine alone. To run one across machines, switch this node to the network provider and pick a model the mesh serves." />

            <!--
                The Python runtime, which is what serves safetensors models. Shown always rather
                than only when something is wrong, because it is set up in the background on
                first launch and a person watching for it should be able to find it.
            -->
            <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Python runtime" />

            <Border Margin="0,6,0,0"
                    Padding="10,8"
                    CornerRadius="4"
                    Background="{DynamicResource Surface.Window.Brush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource Surface.Border.Brush}"
                    DataContext="{Binding DataContext.PythonEnvironment, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel>
                    <DockPanel>
                        <Ellipse DockPanel.Dock="Left"
                                 Width="8"
                                 Height="8"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Fill="{Binding Environment.State, Converter={StaticResource ResourceLookup}, ConverterParameter=PythonEnvironmentState}" />
                        <TextBlock VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="{StaticResource Font.Size.Small}"
                                   Text="{Binding Environment.StatusText}" />
                    </DockPanel>

                    <TextBlock Margin="16,6,0,0"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource Font.Size.Small}"
                               Foreground="{DynamicResource Text.Secondary.Brush}"
                               Text="{Binding Environment.Stage}" />

                    <TextBlock Margin="16,4,0,0"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="{StaticResource Font.Size.Small}"
                               Foreground="{DynamicResource Text.Secondary.Brush}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Environment.Detail}"
                               ToolTip="{Binding Environment.Detail}"
                               Visibility="{Binding Environment.Detail, Converter={StaticResource StringToVisibility}}" />

                    <TextBlock Margin="16,6,0,0"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource Font.Size.Small}"
                               Foreground="{DynamicResource Field.Error.Brush}"
                               Text="{Binding Environment.LastError}"
                               Visibility="{Binding Environment.LastError, Converter={StaticResource StringToVisibility}}" />

                    <TextBlock Margin="16,6,0,0"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource Font.Size.Small}"
                               Foreground="{DynamicResource Text.Secondary.Brush}"
                               Text="{Binding Environment.AcceleratorSummary}"
                               Visibility="{Binding Environment.AcceleratorSummary, Converter={StaticResource StringToVisibility}}" />

                    <WrapPanel Margin="16,8,0,0">
                        <Button Style="{StaticResource SmallButton}"
                                Margin="0,0,6,4"
                                Content="Repair"
                                ToolTip="Builds whatever is missing, reusing everything already downloaded"
                                Command="{Binding RepairCommand}" />
                        <Button Style="{StaticResource SmallButton}"
                                Margin="0,0,6,4"
                                Content="Set up again"
                                ToolTip="Deletes the environment and builds it from the cached downloads"
                                Command="{Binding ResetCommand}" />
                        <Button Style="{StaticResource SmallButton}"
                                Margin="0,0,0,4"
                                Content="Open runtime folder"
                                Command="{Binding OpenFolderCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource HintText}"
                       Text="Set up in the background on first launch. GGUF models do not need it and work while it runs." />
        </StackPanel>

        <!-- Network served model -->
        <StackPanel Visibility="{Binding IsNetwork, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Network model" />
            <ComboBox ItemsSource="{Binding Mesh.Models}"
                      SelectedItem="{Binding SelectedNetworkModel}">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CanRun}" Value="False">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource Font.Size.Small}"
                                       Text="{Binding StatusText}"
                                       Foreground="{Binding Strength, Converter={StaticResource ResourceLookup}, ConverterParameter=SectionCoverage}" />
                            <TextBlock Text="{Binding DisplayLabel}" VerticalAlignment="Center" />
                        </DockPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Style="{StaticResource HintText}"
                       Text="Models the mesh can serve right now, from the Network tab. A model that is starting or blocked cannot be picked; the tab shows which section it is waiting on. Whether the model runs on one machine or as layer stages across several is the mesh's decision, made at run time." />
        </StackPanel>

        <!-- Self hosted server -->
        <StackPanel Visibility="{Binding IsSelfHosted, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Model id" />
            <TextBox Text="{Binding SelfHostedModelId, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource Font.Mono}" />
            <TextBlock Style="{StaticResource HintText}"
                       Text="The model name your server expects in requests. Set the server's address under Endpoint below; nothing is spawned." />

            <TextBlock Style="{StaticResource FieldLabel}" Text="API key (optional)" />
            <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource Font.Mono}" />
            <TextBlock Style="{StaticResource HintText}"
                       Text="Sent as a bearer token when your server requires one. Stored in plain text inside the saved graph file." />
        </StackPanel>

        <!-- OpenRouter model selection -->
        <StackPanel Visibility="{Binding IsOpenRouter, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="OpenRouter model slug" />
            <TextBox Text="{Binding OpenRouterModel, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource Font.Mono}" />
            <TextBlock Style="{StaticResource HintText}"
                       Text="For example anthropic/claude-sonnet-4 or meta-llama/llama-3.3-70b-instruct" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="API key" />
            <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource Font.Mono}" />
            <TextBlock Style="{StaticResource HintText}"
                       Text="Stored in plain text inside the saved graph file. Keep shared graphs free of keys." />
        </StackPanel>

        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Prompt" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="System prompt" />
        <TextBox Style="{StaticResource MonoTextBox}"
                 Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="120"
                 MaxHeight="260" />

        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Edits" />

        <StackPanel Margin="0,6,0,0">
            <RadioButton Content="Automatic"
                         GroupName="EditFormat"
                         Margin="0,0,0,4"
                         IsChecked="{Binding EditFormat, Converter={StaticResource EnumToBoolean}, ConverterParameter=Automatic}" />
            <RadioButton Content="Always the whole file"
                         GroupName="EditFormat"
                         Margin="0,0,0,4"
                         IsChecked="{Binding EditFormat, Converter={StaticResource EnumToBoolean}, ConverterParameter=WholeFile}" />
            <RadioButton Content="Always a diff"
                         GroupName="EditFormat"
                         IsChecked="{Binding EditFormat, Converter={StaticResource EnumToBoolean}, ConverterParameter=LineTaggedDiff}" />
        </StackPanel>

        <TextBlock Style="{StaticResource HintText}"
                   Text="How this node is asked to express a change to an existing file. Automatic sends the whole file for a new or short one and a line tagged diff for anything larger, which is the format smaller models handle best. The applier tolerates whitespace that does not match, and names the lines it could not find when it cannot." />

        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Sampling" />

        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Temperature" />
                <TextBox Text="{Binding Temperature, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Max tokens" />
                <TextBox Text="{Binding MaxTokens, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
        </Grid>

        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,20,0,0" Text="Endpoint" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Base URL" />
        <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                 FontFamily="{StaticResource Font.Mono}" />
        <TextBlock Style="{StaticResource HintText}"
                   Text="Leave blank for a local model and LocalNEXUS starts and reuses its own servers, splitting across sources when needed. Set it to point this node at a server that is already running; nothing is spawned then." />
    </StackPanel>
</UserControl>
