<Window x:Class="LocalNEXUS.App.Views.ExtensionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LocalNEXUS.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ExtensionsViewModel}"
        Title="Extensions"
        Height="680"
        Width="1080"
        MinHeight="480"
        MinWidth="880"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Window.Brush}"
        Foreground="{DynamicResource Text.Primary.Brush}"
        FontFamily="{StaticResource Font.Sans}"
        TextOptions.TextFormattingMode="Ideal">

    <!--
        Three panes across, after Unity's package manager. The reason that shape works is that it
        puts the list and the detail of one thing side by side, so browsing is scanning a column
        rather than scrolling a page. The old settings section stacked all of this into one narrow
        column, which turned looking at extensions into filling in a form.
    -->

    <Window.Resources>
        <!-- The state glyph. Colour comes from the existing status brushes, never a literal. -->
        <Style x:Key="StateGlyph" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource Accent.Neutral.Brush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter Property="Fill" Value="{DynamicResource Status.Success.Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Starting">
                    <Setter Property="Fill" Value="{DynamicResource Status.Info.Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Installing">
                    <Setter Property="Fill" Value="{DynamicResource Status.Info.Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Unreachable">
                    <Setter Property="Fill" Value="{DynamicResource Status.Warning.Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter Property="Fill" Value="{DynamicResource Status.Error.Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter Property="Fill" Value="{DynamicResource Accent.Neutral.Brush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="168" />
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: which shelf. -->
        <Border Grid.Column="0"
                Background="{DynamicResource Surface.Panel.Brush}"
                BorderBrush="{DynamicResource Surface.Border.Brush}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="12,16,12,0">
                <TextBlock Style="{StaticResource SideBarHeader}" Text="SOURCES" Margin="4,0,0,8" />

                <RadioButton Content="Presets"
                             GroupName="ExtensionShelf"
                             Margin="0,2"
                             AutomationProperties.Name="Presets"
                             IsChecked="{Binding Source, Converter={StaticResource EnumToBoolean}, ConverterParameter=Presets}" />

                <RadioButton Content="Installed"
                             GroupName="ExtensionShelf"
                             Margin="0,2"
                             AutomationProperties.Name="Installed"
                             IsChecked="{Binding Source, Converter={StaticResource EnumToBoolean}, ConverterParameter=Installed}" />

                <TextBlock Style="{StaticResource HintText}"
                           Margin="4,18,0,0"
                           TextWrapping="Wrap"
                           Text="{Binding BusyMessage}"
                           Visibility="{Binding BusyMessage, Converter={StaticResource StringToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- Middle: the toolbar and the list. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource Surface.Border.Brush}"
                    BorderThickness="0,0,1,1"
                    Padding="10,8">
                <DockPanel>
                    <Menu DockPanel.Dock="Left" Background="Transparent" Padding="0">
                        <MenuItem Header="&#xE710;"
                                  FontFamily="{StaticResource Font.Icons}"
                                  FontSize="13"
                                  Padding="8,4"
                                  ToolTip="Add an extension"
                                  AutomationProperties.Name="Add an extension">
                            <MenuItem Header="From npm"
                                      InputGestureText="a package name"
                                      Command="{Binding AddNpmCommand}" />
                            <MenuItem Header="From git"
                                      InputGestureText="a repository url"
                                      Command="{Binding AddGitCommand}" />
                            <MenuItem Header="From disk"
                                      InputGestureText="a folder with a manifest"
                                      Command="{Binding AddDiskCommand}" />
                            <MenuItem Header="By command"
                                      InputGestureText="anything else"
                                      Command="{Binding AddCommandCommand}" />
                        </MenuItem>
                    </Menu>

                    <TextBox Margin="8,0,0,0"
                             VerticalContentAlignment="Center"
                             AutomationProperties.Name="Filter extensions"
                             Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Filter by name or description" />
                </DockPanel>
            </Border>

            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource Surface.Border.Brush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <!-- Presets. -->
                    <ListBox ItemsSource="{Binding VisiblePresets}"
                             SelectedItem="{Binding SelectedPreset}"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ItemContainerStyle="{StaticResource ListRow}"
                             AutomationProperties.Name="Preset extensions"
                             Visibility="{Binding ShowPresets, Converter={StaticResource BooleanToVisibility}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <StackPanel HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource HintText}" Text="{Binding ContributionSummary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="{Binding Version}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Installed. -->
                    <ListBox ItemsSource="{Binding VisibleInstalled}"
                             SelectedItem="{Binding Selected}"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ItemContainerStyle="{StaticResource ListRow}"
                             AutomationProperties.Name="Installed extensions"
                             Visibility="{Binding ShowInstalled, Converter={StaticResource BooleanToVisibility}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Ellipse Style="{StaticResource StateGlyph}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Manifest.Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="{Binding Manifest.Version}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Nothing to show, which has two different reasons and says which. -->
                    <TextBlock Style="{StaticResource HintText}"
                               Margin="16"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top"
                               Text="{Binding EmptyMessage}"
                               Visibility="{Binding ShowEmptyMessage, Converter={StaticResource BooleanToVisibility}}" />

                    <TextBlock Style="{StaticResource HintText}"
                               Margin="16"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top"
                               Text="Nothing matches that."
                               Visibility="{Binding FilterHidesEverything, Converter={StaticResource BooleanToVisibility}}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Right: everything about whatever is selected. -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="22,18,22,18">
            <Grid>
                <TextBlock Style="{StaticResource HintText}"
                           Text="Select an extension to see what it is and what it adds."
                           VerticalAlignment="Top">
                    <TextBlock.Visibility>
                        <Binding Path="HasNothingSelected" Converter="{StaticResource BooleanToVisibility}" />
                    </TextBlock.Visibility>
                </TextBlock>

                <!-- A preset, which is not installed and so has one action. -->
                <StackPanel DataContext="{Binding SelectedPreset}"
                            Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                    <TextBlock Style="{StaticResource SectionHeader}" FontSize="{StaticResource Font.Size.Title}" Text="{Binding Name}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource HintText}" Text="{Binding Version}" />
                        <TextBlock Style="{StaticResource HintText}" Text="{Binding Author}" Margin="10,0,0,0" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource HintText}" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,12,0,0" />

                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Status.Warning.Brush}"
                               Text="{Binding Deprecated}"
                               Visibility="{Binding Deprecated, Converter={StaticResource NullToVisibility}}" />

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Adds" Margin="0,18,0,0" />
                    <TextBlock Text="{Binding ContributionSummary}" />

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Needs" Margin="0,18,0,0" />
                    <ItemsControl ItemsSource="{Binding Prerequisites}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Style="{StaticResource MonoText}" Text="{Binding Name}" />
                                    <TextBlock Style="{StaticResource HintText}" Text="{Binding Reason}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Runs" Margin="0,18,0,0" />
                    <TextBlock Style="{StaticResource MonoText}" Text="{Binding Launch.DisplayCommand}" TextWrapping="Wrap" />

                    <TextBlock Style="{StaticResource SectionHeader}" Text="More" Margin="0,18,0,0" />
                    <TextBlock Style="{StaticResource MonoText}" Text="{Binding Homepage}" TextWrapping="Wrap" />

                    <Button Content="Install"
                            HorizontalAlignment="Left"
                            Margin="0,20,0,0"
                            MinWidth="96"
                            Command="{Binding DataContext.InstallPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                </StackPanel>

                <!-- Something installed, which has a state and several actions. -->
                <StackPanel DataContext="{Binding Selected}"
                            Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                    <TextBlock Style="{StaticResource SectionHeader}" FontSize="{StaticResource Font.Size.Title}" Text="{Binding Manifest.Name}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource HintText}" Text="{Binding Manifest.Version}" />
                        <TextBlock Style="{StaticResource HintText}" Text="{Binding Manifest.Author}" Margin="10,0,0,0" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource HintText}" Text="{Binding Manifest.Description}" TextWrapping="Wrap" Margin="0,12,0,0" />

                    <TextBlock Style="{StaticResource HintText}"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Status.Warning.Brush}"
                               Text="{Binding Manifest.Deprecated}"
                               Visibility="{Binding Manifest.Deprecated, Converter={StaticResource NullToVisibility}}" />

                    <TextBlock Style="{StaticResource SectionHeader}" Text="State" Margin="0,18,0,0" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource StateGlyph}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource HintText}" Text="{Binding StateDetail}" TextWrapping="Wrap" Margin="0,4,0,0" />

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Adds" Margin="0,18,0,0" />
                    <TextBlock Text="{Binding Manifest.ContributionSummary}" />

                    <ItemsControl ItemsSource="{Binding DiscoveredTools}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Style="{StaticResource MonoText}" Text="{Binding Name}" />
                                    <TextBlock Style="{StaticResource HintText}" Text="{Binding Description}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Manifest.Nodes}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource HintText}" Text="{Binding Description}" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding Inputs}" Margin="0,3,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource HintText}">
                                                    <Run Text="in" />
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                    <Run Text="{Binding Type, Mode=OneWay}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Outputs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource HintText}">
                                                    <Run Text="out" />
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                    <Run Text="{Binding Type, Mode=OneWay}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Needs" Margin="0,18,0,0" />
                    <ItemsControl ItemsSource="{Binding Manifest.Prerequisites}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Style="{StaticResource MonoText}" Text="{Binding Name}" />
                                    <TextBlock Style="{StaticResource HintText}" Text="{Binding Reason}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Added from" Margin="0,18,0,0" />
                    <TextBlock Style="{StaticResource MonoText}" Text="{Binding OriginDetail}" TextWrapping="Wrap" />

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Runs" Margin="0,18,0,0" />
                    <TextBlock Style="{StaticResource MonoText}" Text="{Binding Manifest.Launch.DisplayCommand}" TextWrapping="Wrap" />

                    <WrapPanel Margin="0,20,0,0">
                        <Button Content="Test connect"
                                Margin="0,0,8,8"
                                MinWidth="96"
                                Command="{Binding DataContext.TestConnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button Content="Disable"
                                Margin="0,0,8,8"
                                MinWidth="88"
                                Command="{Binding DataContext.DisableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsEnabled, Converter={StaticResource BooleanToVisibility}}" />
                        <Button Content="Enable"
                                Margin="0,0,8,8"
                                MinWidth="88"
                                Command="{Binding DataContext.EnableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsEnabled, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}" />
                        <Button Content="View logs"
                                Margin="0,0,8,8"
                                MinWidth="88"
                                Command="{Binding DataContext.ViewLogsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button Content="Remove"
                                Margin="0,0,8,8"
                                MinWidth="88"
                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
