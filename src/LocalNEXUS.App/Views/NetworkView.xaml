<UserControl x:Class="LocalNEXUS.App.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LocalNEXUS.App.ViewModels"
             xmlns:distributed="clr-namespace:LocalNEXUS.App.Services.Distributed"
             d:DataContext="{d:DesignInstance Type=vm:NetworkViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource Surface.Window.Brush}">

    <Grid Margin="24,20,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="480" />
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- ============================ Models and the chain ============================ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Available models"
                               FontSize="{StaticResource Font.Size.Title}"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="{StaticResource Font.Size.Small}"
                               Foreground="{StaticResource Text.Secondary.Brush}"
                               Text="{Binding Mesh.StatusText}" />
                </StackPanel>
            </DockPanel>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Mesh.Models}"
                     SelectedItem="{Binding SelectedModel}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type distributed:NetworkServedModel}">
                        <DockPanel>

                            <!-- Signal strength, decided by the weakest section -->
                            <StackPanel DockPanel.Dock="Left"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="0,0,16,0">
                                <Rectangle Width="5" Height="8" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Fill" Value="{StaticResource Surface.Border.Brush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasDepth1}" Value="True">
                                                    <Setter Property="Fill" Value="{Binding Strength, Converter={StaticResource ResourceLookup}, ConverterParameter=SectionCoverage}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Width="5" Height="13" RadiusX="1" RadiusY="1" Margin="3,0,0,0" VerticalAlignment="Bottom">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Fill" Value="{StaticResource Surface.Border.Brush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasDepth2}" Value="True">
                                                    <Setter Property="Fill" Value="{Binding Strength, Converter={StaticResource ResourceLookup}, ConverterParameter=SectionCoverage}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Width="5" Height="18" RadiusX="1" RadiusY="1" Margin="3,0,0,0" VerticalAlignment="Bottom">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Fill" Value="{StaticResource Surface.Border.Brush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasDepth3}" Value="True">
                                                    <Setter Property="Fill" Value="{Binding Strength, Converter={StaticResource ResourceLookup}, ConverterParameter=SectionCoverage}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                            </StackPanel>

                            <!-- Complete or blocked, the signal that matters most -->
                            <Border DockPanel.Dock="Right"
                                    VerticalAlignment="Center"
                                    CornerRadius="10"
                                    BorderThickness="1"
                                    Padding="10,3"
                                    Margin="16,0,0,0"
                                    BorderBrush="{Binding Strength, Converter={StaticResource ResourceLookup}, ConverterParameter=SectionCoverage}">
                                <TextBlock Text="{Binding StatusText}"
                                           FontSize="{StaticResource Font.Size.Small}"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding Strength, Converter={StaticResource ResourceLookup}, ConverterParameter=SectionCoverage}" />
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="{StaticResource Font.Size.Large}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Border Background="{StaticResource Surface.Window.Brush}"
                                            BorderBrush="{StaticResource Surface.Border.Brush}"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Padding="6,1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Quantization}"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="{StaticResource Font.Size.Small}"
                                                   Foreground="{StaticResource Text.Secondary.Brush}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Margin="0,4,0,0"
                                           FontSize="{StaticResource Font.Size.Small}"
                                           Foreground="{StaticResource Text.Secondary.Brush}">
                                    <Run Text="{Binding RequirementText, Mode=OneWay}" /><Run Text="    " /><Run Text="{Binding PeerCountText, Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock Margin="0,3,0,0"
                                           FontSize="{StaticResource Font.Size.Small}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource SectionCoverage.Uncovered.Brush}"
                                           Text="{Binding IncompleteReason}"
                                           Visibility="{Binding IncompleteReason, Converter={StaticResource StringToVisibility}}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- The chain: sections in pipeline order, left to right -->
            <StackPanel Grid.Row="2" Margin="0,18,0,0">
                <TextBlock Text="Coverage chain"
                           FontSize="{StaticResource Font.Size.Title}"
                           FontWeight="SemiBold" />

                <TextBlock Margin="0,4,0,0"
                           FontSize="{StaticResource Font.Size.Small}"
                           TextWrapping="Wrap"
                           Text="{Binding SelectedModel.ChainStatusText, FallbackValue='Select a model to see how it is assembled.'}"
                           Foreground="{Binding SelectedModel.Strength, Converter={StaticResource ResourceLookup}, ConverterParameter=SectionCoverage, FallbackValue={StaticResource Text.Secondary.Brush}}" />

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="0,12,0,0"
                              Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibility}}">
                    <ItemsControl ItemsSource="{Binding SelectedModel.Plan.Assignments}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type distributed:SourceAssignment}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                    <!-- The wire into this section from the previous one -->
                                    <Rectangle Width="26"
                                               Height="2"
                                               Fill="{StaticResource Surface.Border.Brush}"
                                               VerticalAlignment="Center">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Section.Index}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>

                                    <Border Width="172"
                                            CornerRadius="8"
                                            Background="{StaticResource Surface.Card.Brush}"
                                            BorderThickness="1.5"
                                            Padding="14,11"
                                            BorderBrush="{Binding Coverage, Converter={StaticResource ResourceLookup}, ConverterParameter=SectionCoverage}">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding Section.LayerRangeText}"
                                                           FontSize="{StaticResource Font.Size.Small}"
                                                           Foreground="{StaticResource Text.Secondary.Brush}" />
                                                <TextBlock Text="{Binding Section.Ordinal}"
                                                           FontSize="{StaticResource Font.Size.Small}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource Text.Secondary.Brush}" />
                                            </DockPanel>

                                            <TextBlock Margin="0,7,0,0"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding SourceText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCovered}" Value="False">
                                                                <Setter Property="Foreground" Value="{StaticResource SectionCoverage.Uncovered.Brush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Rectangle Width="5" Height="7" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom">
                                                    <Rectangle.Style>
                                                        <Style TargetType="Rectangle">
                                                            <Setter Property="Fill" Value="{StaticResource Surface.Border.Brush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Depth1}" Value="True">
                                                                    <Setter Property="Fill" Value="{Binding Coverage, Converter={StaticResource ResourceLookup}, ConverterParameter=SectionCoverage}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Rectangle.Style>
                                                </Rectangle>
                                                <Rectangle Width="5" Height="11" RadiusX="1" RadiusY="1" Margin="3,0,0,0" VerticalAlignment="Bottom">
                                                    <Rectangle.Style>
                                                        <Style TargetType="Rectangle">
                                                            <Setter Property="Fill" Value="{StaticResource Surface.Border.Brush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Depth2}" Value="True">
                                                                    <Setter Property="Fill" Value="{Binding Coverage, Converter={StaticResource ResourceLookup}, ConverterParameter=SectionCoverage}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Rectangle.Style>
                                                </Rectangle>
                                                <Rectangle Width="5" Height="15" RadiusX="1" RadiusY="1" Margin="3,0,0,0" VerticalAlignment="Bottom">
                                                    <Rectangle.Style>
                                                        <Style TargetType="Rectangle">
                                                            <Setter Property="Fill" Value="{StaticResource Surface.Border.Brush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Depth3}" Value="True">
                                                                    <Setter Property="Fill" Value="{Binding Coverage, Converter={StaticResource ResourceLookup}, ConverterParameter=SectionCoverage}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Rectangle.Style>
                                                </Rectangle>

                                                <TextBlock Margin="9,0,0,0"
                                                           VerticalAlignment="Bottom"
                                                           FontSize="{StaticResource Font.Size.Small}"
                                                           Text="{Binding CoverageText}"
                                                           Foreground="{Binding Coverage, Converter={StaticResource ResourceLookup}, ConverterParameter=SectionCoverage}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Grid>

        <!-- ============================ This machine, membership and sources ============================ -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Mesh node card: the process the distributed path runs on -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="9"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource Text.Secondary.Brush}"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    ToolTip="The mesh node is a child process. It joins a private mesh on the local network unless you publish it, and stopping it leaves local inference untouched.">
                                <TextBlock Text="?"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="{StaticResource Font.Size.Small}"
                                           Foreground="{StaticResource Text.Secondary.Brush}" />
                            </Border>
                            <TextBlock Text="This machine"
                                       FontSize="{StaticResource Font.Size.Large}"
                                       FontWeight="SemiBold" />
                        </DockPanel>

                        <TextBlock Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="{StaticResource Font.Size.Small}"
                                   Foreground="{StaticResource Text.Secondary.Brush}"
                                   Text="{Binding Mesh.StatusText}" />

                        <TextBlock Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="{StaticResource Font.Size.Small}"
                                   Foreground="{StaticResource SectionCoverage.Uncovered.Brush}"
                                   Text="{Binding Mesh.LastError}"
                                   Visibility="{Binding Mesh.LastError, Converter={StaticResource StringToVisibility}}" />

                        <Button Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding ToggleMeshCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="Start mesh node" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Mesh.IsRunning}" Value="True">
                                            <Setter Property="Content" Value="Stop mesh node" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Contribution card -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="9"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource Text.Secondary.Brush}"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    ToolTip="The memory cap is enforced by the mesh planner, not merely declared: a model that does not fit inside it is never placed on this machine.">
                                <TextBlock Text="?"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="{StaticResource Font.Size.Small}"
                                           Foreground="{StaticResource Text.Secondary.Brush}" />
                            </Border>
                            <TextBlock Text="Contribution"
                                       FontSize="{StaticResource Font.Size.Large}"
                                       FontWeight="SemiBold" />
                        </DockPanel>

                        <CheckBox Margin="0,10,0,0"
                                  Content="Offer this machine's compute"
                                  IsChecked="{Binding Contribute}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,4" Text="Model this machine serves" />
                        <ComboBox ItemsSource="{Binding Catalog.Models}"
                                  SelectedItem="{Binding OfferedModel}"
                                  DisplayMemberPath="Name"
                                  IsEnabled="{Binding Contribute}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,4" Text="Memory cap in GB, blank to let the engine decide" />
                        <TextBox Text="{Binding MaxVramGb, UpdateSourceTrigger=LostFocus}"
                                 IsEnabled="{Binding Contribute}" />

                        <CheckBox Margin="0,12,0,0"
                                  Content="Publish this mesh publicly"
                                  IsChecked="{Binding Publish}"
                                  ToolTip="Off by default. A private mesh stays on the local network and is joined only with its invite token." />

                        <Button Margin="0,14,0,0"
                                HorizontalAlignment="Left"
                                Content="Apply"
                                Command="{Binding ApplySettingsCommand}" />
                    </StackPanel>
                </Border>

                <!-- Membership: the invite others need to join this mesh -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Mesh"
                                   FontSize="{StaticResource Font.Size.Large}"
                                   FontWeight="SemiBold" />

                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,4" Text="Name" />
                        <TextBox Text="{Binding MeshName, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Margin="0,12,0,4"
                                   Text="Invite token for this mesh, share it to let a machine join"
                                   Visibility="{Binding Mesh.HasInviteToken, Converter={StaticResource BooleanToVisibility}}" />
                        <TextBox Text="{Binding Mesh.InviteToken, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 MaxHeight="72"
                                 FontFamily="{StaticResource Font.Mono}"
                                 FontSize="{StaticResource Font.Size.Small}"
                                 VerticalScrollBarVisibility="Auto"
                                 Visibility="{Binding Mesh.HasInviteToken, Converter={StaticResource BooleanToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- Sources, secondary to the models above -->
                <DockPanel Margin="0,22,0,10">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource SmallButton}"
                            VerticalAlignment="Center"
                            Content="+"
                            Width="26"
                            ToolTip="Join a mesh with an invite token"
                            Command="{Binding ToggleJoinCommand}" />
                    <StackPanel>
                        <TextBlock Text="Sources"
                                   FontSize="{StaticResource Font.Size.Large}"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="{StaticResource Font.Size.Small}"
                                   Foreground="{StaticResource Text.Secondary.Brush}"
                                   Text="Reported by the mesh. Nothing here is configured by hand." />
                    </StackPanel>
                </DockPanel>

                <!-- Join form, behind the plus rather than on the page -->
                <Border Style="{StaticResource Card}"
                        Margin="0,0,0,12"
                        Visibility="{Binding IsJoinOpen, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Invite token" />
                        <TextBox Text="{Binding JoinToken, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 MaxHeight="72"
                                 FontFamily="{StaticResource Font.Mono}"
                                 FontSize="{StaticResource Font.Size.Small}"
                                 VerticalScrollBarVisibility="Auto" />

                        <TextBlock Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="{StaticResource Font.Size.Small}"
                                   Foreground="{StaticResource Text.Secondary.Brush}"
                                   Text="Joining restarts the mesh node. Leave the token blank to host a private mesh of your own instead." />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Join"
                                    Command="{Binding JoinMeshCommand}" />
                            <Button Style="{StaticResource SmallButton}"
                                    Margin="8,0,0,0"
                                    Content="Leave"
                                    Command="{Binding LeaveMeshCommand}" />
                            <Button Style="{StaticResource SmallButton}"
                                    Margin="8,0,0,0"
                                    Content="Cancel"
                                    Command="{Binding ToggleJoinCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Mesh.Sources}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type distributed:InferenceSource}">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding State}"
                                                   VerticalAlignment="Center"
                                                   FontSize="{StaticResource Font.Size.Small}"
                                                   Foreground="{Binding State, Converter={StaticResource ResourceLookup}, ConverterParameter=SourceState}" />
                                        <Ellipse Width="8"
                                                 Height="8"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding State, Converter={StaticResource ResourceLookup}, ConverterParameter=SourceState}" />
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>

                                    <TextBlock Margin="0,8,0,0"
                                               FontSize="{StaticResource Font.Size.Small}"
                                               Foreground="{StaticResource Text.Secondary.Brush}">
                                        <Run Text="{Binding EndpointText, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" /><Run Text="    " /><Run Text="{Binding Locality, Mode=OneWay}" />
                                    </TextBlock>

                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="{StaticResource Font.Size.Small}"
                                               Foreground="{StaticResource Text.Secondary.Brush}">
                                        <Run Text="Last seen" /><Run Text=" " /><Run Text="{Binding LastSeenText, Mode=OneWay}" /><Run Text="    " /><Run Text="{Binding CapabilityText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
