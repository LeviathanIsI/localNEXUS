<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Every brush in the application, defined exactly once.

        A theme dictionary supplies colours and nothing else. This file turns them into the
        semantic brushes everything binds to, so a theme never has to know what a coverage level
        or a node state is, and adding a state means adding one line here rather than five lines
        across five themes.

        The colour is a DynamicResource but the brush object is not replaced, which is the whole
        mechanism: swapping the theme dictionary repaints these brushes in place, so anything
        already holding one, including a value a converter resolved during the last layout pass,
        follows the change without being re-evaluated. Freezing any of these would break that, so
        none of them is frozen.

        Three rules the state brushes follow, and they are the reason there is a rule at all:

        In progress is never a failure. Starting, Provisioning, Loading and Checking take the
        info colour, never the danger one. Something still coming up must never look like
        something that broke.

        Pending is quiet, not a warning. It takes the neutral colour, which is grey in every
        theme. A node that has not run yet is not asking for attention.

        Thin is a real warning and Uncovered is a real failure. One spare source left is worth
        saying out loud; none at all is a different thing again.
    -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Surface.Window.Brush" Color="{DynamicResource Surface.WindowColor}" />
    <SolidColorBrush x:Key="Surface.Panel.Brush" Color="{DynamicResource Surface.PanelColor}" />
    <SolidColorBrush x:Key="Surface.Card.Brush" Color="{DynamicResource Surface.CardColor}" />
    <SolidColorBrush x:Key="Surface.Input.Brush" Color="{DynamicResource Surface.InputColor}" />
    <SolidColorBrush x:Key="Surface.Border.Brush" Color="{DynamicResource Surface.BorderColor}" />
    <SolidColorBrush x:Key="Surface.Chrome.Brush" Color="{DynamicResource Surface.ChromeColor}" />
    <SolidColorBrush x:Key="Surface.Hover.Brush" Color="{DynamicResource Surface.HoverColor}" />
    <SolidColorBrush x:Key="Surface.Selected.Brush" Color="{DynamicResource Surface.SelectedColor}" />
    <SolidColorBrush x:Key="Surface.Track.Brush" Color="{DynamicResource Surface.TrackColor}" />
    <SolidColorBrush x:Key="Surface.Scrim.Brush" Color="{DynamicResource Surface.ScrimColor}" />

    <!-- Text -->
    <SolidColorBrush x:Key="Text.Primary.Brush" Color="{DynamicResource Text.PrimaryColor}" />
    <SolidColorBrush x:Key="Text.Secondary.Brush" Color="{DynamicResource Text.SecondaryColor}" />
    <SolidColorBrush x:Key="Text.Muted.Brush" Color="{DynamicResource Text.MutedColor}" />
    <SolidColorBrush x:Key="Text.Inverse.Brush" Color="{DynamicResource Text.InverseColor}" />

    <!-- Accent -->
    <SolidColorBrush x:Key="Accent.Primary.Brush" Color="{DynamicResource Accent.PrimaryColor}" />
    <SolidColorBrush x:Key="Accent.Neutral.Brush" Color="{DynamicResource Accent.NeutralColor}" />

    <!-- Status. The four words everything else is expressed in. -->
    <SolidColorBrush x:Key="Status.Success.Brush" Color="{DynamicResource Status.SuccessColor}" />
    <SolidColorBrush x:Key="Status.Info.Brush" Color="{DynamicResource Status.InfoColor}" />
    <SolidColorBrush x:Key="Status.Danger.Brush" Color="{DynamicResource Status.DangerColor}" />
    <SolidColorBrush x:Key="Status.Warning.Brush" Color="{DynamicResource Status.WarningColor}" />

    <!-- Diff counts in the activity feed -->
    <SolidColorBrush x:Key="Diff.Added.Brush" Color="{DynamicResource Diff.AddedColor}" />
    <SolidColorBrush x:Key="Diff.Removed.Brush" Color="{DynamicResource Diff.RemovedColor}" />

    <!-- Pin types -->
    <SolidColorBrush x:Key="Pin.Text.Brush" Color="{DynamicResource Pin.TextColor}" />
    <SolidColorBrush x:Key="Pin.Code.Brush" Color="{DynamicResource Pin.CodeColor}" />

    <!-- Node type accents. The only colour a node carries. -->
    <SolidColorBrush x:Key="NodeType.Input.Brush" Color="{DynamicResource NodeType.InputColor}" />
    <SolidColorBrush x:Key="NodeType.Plan.Brush" Color="{DynamicResource NodeType.PlanColor}" />
    <SolidColorBrush x:Key="NodeType.Model.Brush" Color="{DynamicResource NodeType.ModelColor}" />
    <SolidColorBrush x:Key="NodeType.Transform.Brush" Color="{DynamicResource NodeType.TransformColor}" />
    <SolidColorBrush x:Key="NodeType.CompileCheck.Brush" Color="{DynamicResource NodeType.CompileColor}" />
    <SolidColorBrush x:Key="NodeType.Output.Brush" Color="{DynamicResource NodeType.OutputColor}" />

    <!-- Node execution state, as the model records it. -->
    <SolidColorBrush x:Key="NodeState.Pending.Brush" Color="{DynamicResource Accent.NeutralColor}" />
    <SolidColorBrush x:Key="NodeState.Running.Brush" Color="{DynamicResource Status.InfoColor}" />
    <SolidColorBrush x:Key="NodeState.Completed.Brush" Color="{DynamicResource Status.SuccessColor}" />
    <SolidColorBrush x:Key="NodeState.Faulted.Brush" Color="{DynamicResource Status.DangerColor}" />

    <!--
        Node state as it is drawn, which has one more value than the model does. A node still
        Pending when the run faulted never ran and never will, and painting it the same quiet grey
        as a node waiting its turn is the honest answer: it did not fail, it was not reached.
    -->
    <SolidColorBrush x:Key="NodeDisplayState.Pending.Brush" Color="{DynamicResource Accent.NeutralColor}" />
    <SolidColorBrush x:Key="NodeDisplayState.Running.Brush" Color="{DynamicResource Status.InfoColor}" />
    <SolidColorBrush x:Key="NodeDisplayState.Completed.Brush" Color="{DynamicResource Status.SuccessColor}" />
    <SolidColorBrush x:Key="NodeDisplayState.Faulted.Brush" Color="{DynamicResource Status.DangerColor}" />
    <SolidColorBrush x:Key="NodeDisplayState.Skipped.Brush" Color="{DynamicResource Accent.NeutralColor}" />

    <!-- Coverage of one section, or of a whole model. -->
    <SolidColorBrush x:Key="SectionCoverage.Starting.Brush" Color="{DynamicResource Status.InfoColor}" />
    <SolidColorBrush x:Key="SectionCoverage.Healthy.Brush" Color="{DynamicResource Status.SuccessColor}" />
    <SolidColorBrush x:Key="SectionCoverage.Thin.Brush" Color="{DynamicResource Status.WarningColor}" />
    <SolidColorBrush x:Key="SectionCoverage.Uncovered.Brush" Color="{DynamicResource Status.DangerColor}" />

    <!-- What the mesh reports about a peer. -->
    <SolidColorBrush x:Key="SourceState.Unknown.Brush" Color="{DynamicResource Accent.NeutralColor}" />
    <SolidColorBrush x:Key="SourceState.Available.Brush" Color="{DynamicResource Status.InfoColor}" />
    <SolidColorBrush x:Key="SourceState.Serving.Brush" Color="{DynamicResource Status.SuccessColor}" />
    <SolidColorBrush x:Key="SourceState.Unreachable.Brush" Color="{DynamicResource Status.DangerColor}" />

    <!-- This install owns exactly one mesh node, and this is its condition. -->
    <SolidColorBrush x:Key="MeshNodeState.Stopped.Brush" Color="{DynamicResource Accent.NeutralColor}" />
    <SolidColorBrush x:Key="MeshNodeState.Starting.Brush" Color="{DynamicResource Status.InfoColor}" />
    <SolidColorBrush x:Key="MeshNodeState.Client.Brush" Color="{DynamicResource Status.InfoColor}" />
    <SolidColorBrush x:Key="MeshNodeState.Serving.Brush" Color="{DynamicResource Status.SuccessColor}" />
    <SolidColorBrush x:Key="MeshNodeState.Failed.Brush" Color="{DynamicResource Status.DangerColor}" />

    <!-- Availability of a model the mesh knows about. -->
    <SolidColorBrush x:Key="ModelAvailability.Starting.Brush" Color="{DynamicResource Status.InfoColor}" />
    <SolidColorBrush x:Key="ModelAvailability.Complete.Brush" Color="{DynamicResource Status.SuccessColor}" />
    <SolidColorBrush x:Key="ModelAvailability.Blocked.Brush" Color="{DynamicResource Status.DangerColor}" />

    <!-- The Python runtime. Provisioning is a download, not a fault. -->
    <SolidColorBrush x:Key="PythonEnvironmentState.Unknown.Brush" Color="{DynamicResource Accent.NeutralColor}" />
    <SolidColorBrush x:Key="PythonEnvironmentState.Missing.Brush" Color="{DynamicResource Accent.NeutralColor}" />
    <SolidColorBrush x:Key="PythonEnvironmentState.Provisioning.Brush" Color="{DynamicResource Status.InfoColor}" />
    <SolidColorBrush x:Key="PythonEnvironmentState.Ready.Brush" Color="{DynamicResource Status.SuccessColor}" />
    <SolidColorBrush x:Key="PythonEnvironmentState.Failed.Brush" Color="{DynamicResource Status.DangerColor}" />

    <!-- The project index. -->
    <SolidColorBrush x:Key="ProjectIndexState.Unknown.Brush" Color="{DynamicResource Accent.NeutralColor}" />
    <SolidColorBrush x:Key="ProjectIndexState.Indexing.Brush" Color="{DynamicResource Status.InfoColor}" />
    <SolidColorBrush x:Key="ProjectIndexState.Ready.Brush" Color="{DynamicResource Status.SuccessColor}" />
    <SolidColorBrush x:Key="ProjectIndexState.Empty.Brush" Color="{DynamicResource Accent.NeutralColor}" />
    <SolidColorBrush x:Key="ProjectIndexState.Unavailable.Brush" Color="{DynamicResource Status.WarningColor}" />

    <!-- How the last compile check ended. -->
    <SolidColorBrush x:Key="CompileOutcome.NotRun.Brush" Color="{DynamicResource Accent.NeutralColor}" />
    <SolidColorBrush x:Key="CompileOutcome.Checking.Brush" Color="{DynamicResource Status.InfoColor}" />
    <SolidColorBrush x:Key="CompileOutcome.Compiled.Brush" Color="{DynamicResource Status.SuccessColor}" />
    <SolidColorBrush x:Key="CompileOutcome.Repaired.Brush" Color="{DynamicResource Status.SuccessColor}" />
    <SolidColorBrush x:Key="CompileOutcome.Failed.Brush" Color="{DynamicResource Status.DangerColor}" />
    <SolidColorBrush x:Key="CompileOutcome.Unavailable.Brush" Color="{DynamicResource Status.WarningColor}" />

    <!-- Severity of one diagnostic in the Problems list. -->
    <SolidColorBrush x:Key="CompileSeverity.Info.Brush" Color="{DynamicResource Status.InfoColor}" />
    <SolidColorBrush x:Key="CompileSeverity.Warning.Brush" Color="{DynamicResource Status.WarningColor}" />
    <SolidColorBrush x:Key="CompileSeverity.Error.Brush" Color="{DynamicResource Status.DangerColor}" />

    <!-- Lifecycle of a run, for the status bar. -->
    <SolidColorBrush x:Key="RunState.Idle.Brush" Color="{DynamicResource Accent.NeutralColor}" />
    <SolidColorBrush x:Key="RunState.Running.Brush" Color="{DynamicResource Status.InfoColor}" />
    <SolidColorBrush x:Key="RunState.Paused.Brush" Color="{DynamicResource Status.WarningColor}" />
    <SolidColorBrush x:Key="RunState.Completed.Brush" Color="{DynamicResource Status.SuccessColor}" />
    <SolidColorBrush x:Key="RunState.Faulted.Brush" Color="{DynamicResource Status.DangerColor}" />

    <!-- Kinds of activity feed entry. -->
    <SolidColorBrush x:Key="Activity.Info.Brush" Color="{DynamicResource Accent.NeutralColor}" />
    <SolidColorBrush x:Key="Activity.Request.Brush" Color="{DynamicResource Accent.PrimaryColor}" />
    <SolidColorBrush x:Key="Activity.RunStarted.Brush" Color="{DynamicResource Status.InfoColor}" />
    <SolidColorBrush x:Key="Activity.RunCompleted.Brush" Color="{DynamicResource Status.SuccessColor}" />
    <SolidColorBrush x:Key="Activity.RunFaulted.Brush" Color="{DynamicResource Status.DangerColor}" />
    <SolidColorBrush x:Key="Activity.NodeStarted.Brush" Color="{DynamicResource Status.InfoColor}" />
    <SolidColorBrush x:Key="Activity.NodeCompleted.Brush" Color="{DynamicResource Status.SuccessColor}" />
    <SolidColorBrush x:Key="Activity.NodeFaulted.Brush" Color="{DynamicResource Status.DangerColor}" />
    <SolidColorBrush x:Key="Activity.ModelStream.Brush" Color="{DynamicResource NodeType.ModelColor}" />
    <SolidColorBrush x:Key="Activity.FileWritten.Brush" Color="{DynamicResource Status.SuccessColor}" />
    <SolidColorBrush x:Key="Activity.Confirmation.Brush" Color="{DynamicResource Status.WarningColor}" />
    <SolidColorBrush x:Key="Activity.Error.Brush" Color="{DynamicResource Status.DangerColor}" />

    <!-- A field level problem in a settings panel, for example a file that is no longer there. -->
    <SolidColorBrush x:Key="Field.Error.Brush" Color="{DynamicResource Status.DangerColor}" />

    <!-- Pending wire feedback: accepted while the drop would be allowed, danger while it would not. -->
    <SolidColorBrush x:Key="Wire.True.Brush" Color="{DynamicResource Status.SuccessColor}" />
    <SolidColorBrush x:Key="Wire.False.Brush" Color="{DynamicResource Status.DangerColor}" />

</ResourceDictionary>
