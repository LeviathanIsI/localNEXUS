<Application x:Class="LocalNEXUS.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Nodify's own control styles come first so the application theme can override them. -->
                <ResourceDictionary Source="pack://application:,,,/Nodify;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Nodify;component/Themes/Nodify.xaml" />

                <!--
                    The theme, which is colours and nothing else. The theme service replaces this
                    entry at startup with whichever theme was last chosen, and again whenever one
                    is picked; the brushes below take their colours from it dynamically, so nothing
                    is rebuilt and nothing has to be restarted.
                -->
                <ResourceDictionary Source="Views/Themes/VsCodeDark.xaml" />

                <ResourceDictionary Source="Views/Brushes.xaml" />
                <ResourceDictionary Source="Views/Theme.xaml" />
                <ResourceDictionary Source="Views/ShellStyles.xaml" />
                <ResourceDictionary Source="Views/NodeTemplates.xaml" />
                <ResourceDictionary Source="Views/SettingsTemplates.xaml" />
                <ResourceDictionary Source="Views/InspectorTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
