<Application x:Class="LocalNEXUS.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Nodify's own control styles come first so the application theme can override them. -->
                <ResourceDictionary Source="pack://application:,,,/Nodify;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Nodify;component/Themes/Nodify.xaml" />

                <!--
                    No colours are merged here. The theme service reads whichever theme was last
                    chosen and puts the brushes straight into these resources before the window is
                    built, and repaints those same brush objects whenever a theme is picked, so
                    nothing is rebuilt and nothing has to be restarted. Everything below asks for
                    its brushes dynamically, which is what lets them arrive after this file is
                    parsed.
                -->
                <ResourceDictionary Source="Views/Theme.xaml" />
                <ResourceDictionary Source="Views/ShellStyles.xaml" />
                <ResourceDictionary Source="Views/NodeTemplates.xaml" />
                <ResourceDictionary Source="Views/SettingsTemplates.xaml" />
                <ResourceDictionary Source="Views/InspectorTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
